self.__PM_SRC={"key-guide.js": "/* Conservative key-assisted reference repair. PCM and results remain on-device. */\n(function(root){\n const midi=f=>69+12*Math.log2(f/440), pc=n=>(Math.round(n)%12+12)%12;\n // Krumhansl–Kessler pitch-class profiles; Pearson correlation of voiced durations.\n // Reference: https://extra.humdrum.org/man/keycor/\n const profiles=[[6.35,2.23,3.48,2.33,4.38,4.09,2.52,5.19,2.39,3.66,2.29,2.88],[6.33,2.68,3.52,5.38,2.60,3.53,2.54,4.75,3.98,2.69,3.34,3.17]];\n function inKey(hz,key){return !!hz&&!!key&&[0,2, key.mode==='minor'?3:4,5,7,key.mode==='minor'?8:9,key.mode==='minor'?10:11].includes((pc(midi(hz))-key.tonic+12)%12)}\n function inferKey(track,step=.04){\n  const hist=Array(12).fill(0);let voiced=0;\n  for(const f of track)if(f>0&&Number.isFinite(f)){hist[pc(midi(f))]+=step;voiced+=step}\n  const mean=voiced/12,variance=hist.reduce((s,v)=>s+(v-mean)**2,0),rank=[];\n  for(let mode=0;mode<2;mode++)for(let tonic=0;tonic<12;tonic++){\n   const p=profiles[mode],avg=p.reduce((s,v)=>s+v,0)/12;\n   let dot=0,power=0;for(let n=0;n<12;n++){const v=p[(n-tonic+12)%12]-avg;dot+=(hist[n]-mean)*v;power+=v*v}\n   rank.push({tonic,mode:mode?'minor':'major',correlation:variance?dot/Math.sqrt(variance*power):0});\n  }\n  rank.sort((a,b)=>b.correlation-a.correlation);const best=rank[0],margin=best.correlation-rank[1].correlation;\n  const diversity=hist.filter(v=>v>=.12).length;\n  const confident=voiced>=4&&diversity>=5&&best.correlation>=.72&&margin>=.10;\n  return {...best,margin,confident,voiced,label:voiced?['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'][best.tonic]+(best.mode==='minor'?' minor':' major'):null};\n }\n const near=(a,b)=>a>0&&b>0&&Math.abs(midi(a)-midi(b))<.6;\n function refine(track,rows,step=.04){\n  const scoring=Float32Array.from(track),key=inferKey(track,step);let corrected=0,filled=0;\n  // Only very short returns to an established pitch. Real sustained leaps and\n  // stable chromatic notes are never pulled toward the inferred scale.\n  for(let i=3;i<track.length-3;i++){\n   const base=track[i-1];if(!base||!track[i]||![1,2,3].every(k=>near(track[i-k],base)))continue;\n   let end=i;while(end<track.length&&end-i<3&&near(track[end],track[i]))end++;\n   if(end-i>2||end+2>=track.length||![0,1,2].every(k=>near(track[end+k],base)))continue;\n   const ratio=Math.max(base,track[i])/Math.min(base,track[i]),harmonic=Math.round(ratio);\n   if(harmonic<2||harmonic>3||Math.abs(12*Math.log2(ratio/harmonic))>.6)continue;\n   const replacements=[];\n   for(let j=i;j<end;j++){\n    const row=rows[j]||[],original=row.find(c=>near(c.hz,track[j]));\n    const alternative=row.filter(c=>near(c.hz,base)).sort((a,b)=>a.local-b.local)[0];\n    if(!original||!alternative)break;\n    // Key supplies a small tie-break only after temporal AND harmonic evidence.\n    const bonus=key.confident&&inKey(alternative.hz,key)&&!inKey(original.hz,key)?.02:0;\n    const independent=(alternative.powers||[]).reduce((s,v,k)=>s+((k+1)%harmonic?v:0),0);\n    if(alternative.local>original.local+.04+bonus||alternative.strength<.8)break;\n    if(alternative.hz<original.hz&&independent<.012)break; // no invented missing fundamental\n    replacements.push(alternative.hz);\n   }\n   if(replacements.length===end-i){replacements.forEach((f,k)=>scoring[i+k]=f);corrected+=end-i}i=end-1;\n  }\n  const display=Float32Array.from(scoring);\n  for(let i=3;i<display.length-3;i++){\n   if(display[i])continue;let end=i;while(end<display.length&&!display[end])end++;\n   const base=display[i-1];if(end-i>2||end+2>=display.length||![1,2,3].every(k=>near(display[i-k],base))||![0,1,2].every(k=>near(display[end+k],base))){i=end-1;continue}\n   const supported=[];\n   for(let j=i;j<end;j++){\n    const candidate=(rows[j]||[]).find(c=>near(c.hz,base)&&c.strength>=.85&&c.local<=.3);\n    if(!candidate)break;supported.push(candidate.hz);\n   }\n   if(supported.length===end-i){supported.forEach((f,k)=>display[i+k]=f);filled+=end-i}i=end-1;\n  }\n  return {hz:scoring,display,key,corrected,filled};\n }\n root.PMKeyGuide={inferKey,inKey,refine};\n})(typeof self!=='undefined'?self:globalThis);\n", "reference-pitch.js": "/* Offline guide-only multi-candidate pitch tracker. No network or persistence. */\n'use strict';\n(function(root){\nconst RATE=8000,MIN=7,MAX=126,WIDTH=288,MAX_CANDIDATES=7;\nconst WIN=400,TAPER=Float64Array.from({length:WIN},(_,i)=>.5-.5*Math.cos(2*Math.PI*i/(WIN-1))),WIN_SUM=(WIN-1)/2;\nconst midi=f=>69+12*Math.log2(f/440), read=(x,i)=>x[i]||0;\nfunction decimate(x){\n const y=new Float32Array(Math.ceil(x.length/2));\n let dc=0;\n for(let j=0;j<y.length;j++){\n  const i=2*j,v=(read(x,i-2)+4*read(x,i-1)+6*read(x,i)+4*read(x,i+1)+read(x,i+2))/16;\n  dc+=.021*(v-dc);y[j]=v-dc;\n }\n return y;\n}\nfunction spectrumFit(data,hz,denom) {\n let sum=0;const powers=[];\n for(const [harmonic,weight] of [[1,1],[2,1],[3,.52],[4,.32]]) {\n  const f=harmonic*hz;if(f>=RATE/2){powers.push(0);continue;}\n  const coef=2*Math.cos(2*Math.PI*f/RATE);\n  let x=0,y=0;\n  for(let i=0;i<data.length;i++){const v=data[i]+coef*x-y;y=x;x=v}\n  const power=Math.max(0,x*x+y*y-coef*x*y)*2/denom;powers.push(power);sum+=weight*power;\n }\n return {fit:Math.min(1,sum),powers};\n}\nfunction candidates(channels,center,corr,window){\n let signal=channels[0],energy=0;\n // Measure near the frame center, not in a neighboring voiced region.\n for(const ch of channels){let e=0;for(let j=center-64;j<center+64;j+=2){const s=read(ch,j);e+=s*s}\n  if(e>energy){signal=ch;energy=e}}\n if(energy<64*.00085**2)return [{hz:0,midi:0,local:0}];\n let top=-1;\n // Symmetric normalized autocorrelation minimizes lag-dependent onset/offset timing bias.\n for(let l=MIN-1;l<=MAX+1;l++){\n  let ab=0,ab2=0;\n  const b=center-(WIDTH>>1)-(l>>1),a=b+l;\n  if(b>=0&&a+WIDTH<=signal.length){\n   for(let j=0;j<WIDTH;j++){const v=signal[b+j],w=signal[a+j];ab+=v*w;ab2+=v*v+w*w}\n  }else{\n   for(let j=0;j<WIDTH;j++){const v=read(signal,b+j),w=read(signal,a+j);ab+=v*w;ab2+=v*v+w*w}\n  }\n  corr[l]=ab2>1e-13?2*ab/ab2:0;\n }\n const peaks=[];\n for(let l=MIN;l<=MAX;l++){\n  const p=corr[l];if(p<.64||p<corr[l-1]||p<=corr[l+1])continue;\n  const d=corr[l-1]-2*p+corr[l+1],k=d<-.000001?Math.max(-.5,Math.min(.5,.5*(corr[l-1]-corr[l+1])/d)):0;\n  const period=l+k,hz=RATE/period;if(hz<63||hz>1060)continue;\n  const strength=Math.min(1,p-.25*(corr[l-1]-corr[l+1])*k);\n  peaks.push({hz,period,strength,midi:midi(hz)});top=Math.max(top,strength);\n }\n if(top<.7)return [{hz:0,midi:0,local:0}];\n // A long period that is merely an integer multiple of an equally strong shorter\n // period is a subharmonic alias; do not assign it the same likelihood.\n let power=0;\n for(let j=0;j<WIN;j++){const v=read(signal,center-(WIN>>1)+j);window[j]=v*TAPER[j];power+=v*v*TAPER[j];}\n const normal=Math.max(1e-12,power*WIN_SUM);\n const voiced=peaks.filter(p=>p.strength>=Math.max(.65,top-.29)).map(p=>{\n  let alias=0;const spectrum=spectrumFit(window,p.hz,normal);\n  for(const q of peaks){\n   if(q.period>=p.period*.68)break;\n   const ratio=p.period/q.period,n=Math.round(ratio);\n   if(n>=2&&n<=16&&Math.abs(ratio-n)<n*.055){\n    const gain=p.strength-q.strength;\n    if(gain<.026)alias=Math.max(alias,.23*Math.max(0,1-Math.max(0,gain)/.026));\n    // Unlike a true low fundamental, a spurious multiple has no measured energy\n    // in the harmonics not already explained by the shorter period.\n    if(n<=3&&q.strength>.72){\n     const independent=spectrum.powers.reduce((a,v,i)=>a+((i+1)%n?v:0),0);\n     alias=Math.max(alias,.18*Math.max(0,1-independent/.012));\n    }\n   }\n  }\n  return {...p,powers:spectrum.powers,local:1.12*(1-p.strength)+alias+.78*(1-spectrum.fit)};\n }).sort((a,b)=>a.local-b.local).slice(0,MAX_CANDIDATES);\n const silenceCost=.12+2.3*(top-.70);\n return [{hz:0,midi:0,local:silenceCost},...voiced];\n}\nfunction transition(from,to){\n if(!from.hz||!to.hz)return from.hz===to.hz?0:.055;\n const cents=Math.abs(from.midi-to.midi)*100;\n return Math.min(.125,Math.max(0,(cents-32)*.00039));\n}\nfunction analyze(channels,length,step=.04,onProgress,details=false){\n const x=channels.map(decimate), rows=[], backs=[], corr=new Float64Array(MAX+2),window=new Float64Array(WIN);\n let prev=null;\n for(let i=0;i<length;i++){\n  const cur=candidates(x,Math.round(i*step*RATE),corr,window), edges=new Uint8Array(cur.length);\n  cur.forEach((to,j)=>{\n   let best=Infinity,at=0;\n   if(prev)prev.forEach((from,k)=>{const c=from.path+transition(from,to);if(c<best){best=c;at=k}});\n   to.path=(prev?best:0)+to.local;edges[j]=at;\n  });\n  rows.push(cur);backs.push(edges);prev=cur;\n  if(i%50===0&&onProgress)onProgress(i/Math.max(1,length));\n }\n const out=new Float32Array(length);\n if(prev){\n  let best=0;for(let i=1;i<prev.length;i++)if(prev[i].path<prev[best].path)best=i;\n  for(let i=length-1;i>=0;i--){out[i]=rows[i][best].hz;best=backs[i][best]}\n }\n if(onProgress)onProgress(1);\n return details?root.PMKeyGuide.refine(out,rows,step):out;\n}\nroot.PMReferencePitch={analyze};\n})(typeof self!=='undefined'?self:globalThis);\n", "__main__": "/* Receives already extracted/dry vocal PCM from this page. No audio leaves the device. */\n'use strict';\nimportScripts('key-guide.js?v=6','reference-pitch.js?v=6');\nself.onmessage=({data:{channels,length,step}})=>{\n try{\n  const result=self.PMReferencePitch.analyze(channels,length,step,value=>self.postMessage({type:'progress',value}),true);\n  self.postMessage({type:'result',...result},[result.hz.buffer,result.display.buffer]);\n }catch(_){self.postMessage({type:'error'});}\n};\n"};
/* 単一HTML版：Workerの中だけで使う読み込み口。外部への通信はしない（fetch は同梱データだけ返し、それ以外は拒否）。 */
(function () {
  const SRC = self.__PM_SRC; delete self.__PM_SRC;
  const urls = {}, real = self.importScripts.bind(self);
  let resolveA; const assetsP = new Promise((r) => { resolveA = r; });
  const st = { paths: null }, own = new Set(), realFetch = self.fetch.bind(self);
  self.__PM_ORT = st;
  function hookOrt() {
    const w = self.ort && self.ort.env && self.ort.env.wasm; if (!w || w.__pmHooked) return;
    Object.defineProperty(w, '__pmHooked', { value: true });
