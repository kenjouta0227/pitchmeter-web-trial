  self.addEventListener('message', (e) => { const d = e.data; if (!d || !d.__pmAssets) return; e.stopImmediatePropagation();
    const a = d.__pmAssets;
    if (a.mjs && a.wasm) { st.paths = { mjs: URL.createObjectURL(new Blob([a.mjs], { type: 'text/javascript' })), wasm: URL.createObjectURL(new Blob([a.wasm], { type: 'application/wasm' })) }; own.add(st.paths.wasm); }
    resolveA(a); });
  self.fetch = async function (u, o) { const k0 = String(u && u.url || u); if (own.has(k0)) return realFetch(k0, o); // このWorkerの中で作った blob: だけ
    const k = k0.split('?')[0].replace(/^\/+/, '');
    const a = await assetsP; if (a.files && k in a.files) return new Response(a.files[k]);
    throw new TypeError('外部通信はしません: ' + k); };
  self.XMLHttpRequest = undefined; self.WebSocket = undefined; self.EventSource = undefined;
})();
