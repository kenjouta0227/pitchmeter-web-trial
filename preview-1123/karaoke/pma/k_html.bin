   const stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}});if(id!==run){stream.getTracks().forEach(t=>t.stop());return}micStream=stream;await audio.resume();if(id!==run)return;
   micNode=audio.createMediaStreamSource(stream);analyser=audio.createAnalyser();analyser.fftSize=8192;micNode.connect(analyser);stream.getAudioTracks()[0].onended=()=>stop('マイクが切断されました。再生し直してください。');
   playNode=audio.createBufferSource();playNode.buffer=buffer;playNode.connect(window.__pmMix.gain(audio,'o'));start=audio.currentTime+3-off;playNode.start(start+off,off);window.__pmMix.startAcc(audio,start+off,off);mode='countdown';controls();status('3、2、1の後に再生します。');
   playNode.onended=()=>{if(id!==run)return;now=buffer.duration;for(const edit of follower.finish())actual[edit.index]=edit.hz;release();mode='ended';window.__pmSeg.to=buffer.duration;window.__pmSeg.pos=0;controls();draw();status('再生終了。「採点する」で結果を確認できます。')};
   const arr=new Float32Array(analyser.fftSize),w=new Float32Array(960);
   function frame(){if(id!==run)return;if(audio.state!=='running'){stop('音声処理が中断しました。再生し直してください。');return}const t=audio.currentTime-start;now=Math.max(0,Math.min(buffer.duration,t));const G=window.__pmSeg.gate||0;el('kCount').textContent=t<G?String(Math.ceil(G-t)):'';
    if(t>=G){if(mode==='countdown'){mode='playing';controls();status('歌ってください。見本と実唱を重ねています。')}const bin=Math.round((t-.03)/step);if(bin>=0&&bin<actual.length&&bin!==lastBin){lastBin=bin;analyser.getFloatTimeDomainData(arr);const ratio=audio.sampleRate/16000;for(let j=0;j<960;j++){const p=arr.length-1-(959-j)*ratio,k=Math.floor(p);w[j]=(arr[k]||0)+(p-k)*((arr[k+1]||0)-(arr[k]||0))}const tracked=follower.push(f0(w),bin);for(const edit of tracked.edits)actual[edit.index]=edit.hz;actual[bin]=tracked.hz;pointer.observe(tracked.hz,now)}}
    draw();raf=requestAnimationFrame(frame)
   }frame();
  }catch(err){if(id===run){stop();status(err.name==='NotAllowedError'?'マイクが許可されていません。Safariのサイト設定で許可してください。':'開始できませんでした：'+err.message)}}
 };
 el('kReview').oninput=()=>{if(!buffer||['loading','starting','countdown','playing'].includes(mode))return;now=Math.max(0,Math.min(buffer.duration,Number(el('kReview').value)||0));pointer.reset();draw()};
 el('kStop').onclick=()=>stop('停止しました。最初から再生し直せます。');window.__pmK={
 state(){const S=window.__pmSeg;return {now,dur:buffer?buffer.duration:0,mode,from:S.from||0,to:S.to,keep:!!S.keep,ready:!!(buffer&&ref.length)}},
 dbg(){const a=Math.floor((window.__pmSeg.from||0)/step);let before=0,inWin=0;actual.forEach((f,i)=>{if(f>0){if(i<a)before++;else inWin++}});return {before,inWin,playing:!!playNode}},
 flush(){for(const edit of follower.finish())actual[edit.index]=edit.hz},
 restartAt(pos){const id=run,S=window.__pmSeg;if(playNode){playNode.onended=null;try{playNode.stop()}catch(_){}playNode.disconnect()}window.__pmMix.stopAcc();
  playNode=audio.createBufferSource();playNode.buffer=buffer;playNode.connect(window.__pmMix.gain(audio,'o'));const t0=audio.currentTime+.05;start=t0-pos;S.gate=pos;playNode.start(t0,pos);window.__pmMix.startAcc(audio,t0,pos);
  playNode.onended=()=>{if(id!==run)return;now=buffer.duration;window.__pmK.flush();release();mode='ended';S.to=buffer.duration;S.pos=0;controls();draw();status('再生終了。「採点する」で結果を確認できます。')}},
 clearTake(from){const S=window.__pmSeg;actual=new Array(ref.length).fill(0);barVerdicts.clear();follower.reset();lastBin=-1;celebration.reset();takeScore=createTakeScorer();S.from=from;S.to=null;S.key='';S.keep=false},
 seek(pos){const S=window.__pmSeg;if(!buffer||!ref.length||['loading','starting','countdown'].includes(mode))return false;pos=Math.max(0,Math.min(buffer.duration-.05,Number(pos)||0));
  if(mode==='playing'){this.clearTake(pos);now=pos;pointer.reset();this.restartAt(pos);status('再生位置を '+fmt(pos)+' に変えました。ここから採点します。');return true}
  this.clearTake(pos);S.pos=pos;now=pos;pointer.reset();if(mode==='ended')mode='ready';controls();draw();status('再生位置 '+fmt(pos)+'。「再生」でここから始まり、ここから採点します。');return true},
 reset(){const S=window.__pmSeg;if(!buffer||!ref.length||['loading','starting','countdown'].includes(mode))return false;
  if(mode==='playing'){this.clearTake(now);status('リセットしました。'+fmt(now)+' から採点し直します。');return true}
  this.clearTake(0);S.pos=0;now=0;pointer.reset();if(mode==='ended')mode='ready';controls();draw();status('リセットしました。最初（0:00）から再生・採点します。');return true},
 pause(){const S=window.__pmSeg;if(['starting','countdown'].includes(mode)){stop('停止しました。');return}if(mode!=='playing')return;this.flush();const pos=now;stop('一時停止しました（'+fmt(pos)+'）。「再生」で続きから。「採点する」でここまでを採点します。');S.pos=pos;S.to=pos;now=pos;S.keep=true;controls();draw()},
 scoreNow(){const S=window.__pmSeg;if(!buffer||!ref.length)return null;
  if(['starting','countdown'].includes(mode)){stop('まだ歌が始まっていないため採点できません。');return null}
  if(mode==='playing'){this.flush();const pos=now;stop();S.to=pos;S.pos=0;now=pos;mode='ended'}
  if(mode==='ready'&&S.keep){S.keep=false;mode='ended'}
  if(mode!=='ended')return null;
  const to=S.to==null?buffer.duration:S.to,from=S.from||0,a=Math.max(0,Math.floor(from/step)),b=Math.min(ref.length,Math.ceil(to/step)),key=a+':'+b;
  if(S.key!==key){S.key=key;takeScore=createTakeScorer()}
  const w=ref.map((f,i)=>i>=a&&i<b?f:0);controls();draw();status('採点区間 '+fmt(from)+' 〜 '+fmt(to)+'（この区間だけを採点）');window.__pmK.last={from,to,a,b};return takeScore(w,actual)}
};

 el('kScore').onclick=()=>{const r=window.__pmK.scoreNow();if(!r)return;el('kResult').hidden=false;el('kResult').replaceChildren();if(!r.valid){el('kResult').textContent=r.reason;return}const strong=document.createElement('strong');strong.textContent=r.score+' 点';const p=document.createElement('p');p.textContent='暫定採点 · 基礎 '+r.baseScore+'点 + 加点 '+r.bonus+'点 · 有声音の一致対象 '+Math.round(r.coverage*100)+'% · 実唱の時間補正 '+(-r.delay).toFixed(2)+'秒';el('kResult').append(strong,p);};
 document.addEventListener('visibilitychange',()=>{if(document.hidden&&['starting','playing','countdown','loading'].includes(mode))stop('画面が離れたため停止しました。再生し直してください。')});window.addEventListener('pagehide',()=>stop());window.addEventListener('resize',draw);show(true);controls();
})();
</script></html>