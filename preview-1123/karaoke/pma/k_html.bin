function run(t){if(id!==rev)return;if(t-last>=40){last=t;z.getFloatTimeDomainData(a);let energy=0;for(let i=0;i<N;i++){const p=a.length-1-(N-1-i)*step,k=Math.floor(p);w[i]=(a[k]??0)+(p-k)*((a[k+1]??a[k]??0)-(a[k]??0));energy+=w[i]**2}const rms=Math.sqrt(energy/N);$('level').value=Math.max(-80,20*Math.log10(rms||.00001));quiet=rms<.004?quiet+1:0;const f=feat(w);display(f);const state=ct.state!=='running'?'ブラウザの音声処理が停止しています。停止して再開してください。':track.muted?'マイクは接続済みですが、入力がミュートされています。':quiet>=12?'マイク接続済み。音が弱いか、入力がありません。':f.f?'マイク入力中':rms>=.004?'入力あり。音程を判定できませんでした。':'マイク接続済み。入力レベルを確認中…';if(m.textContent!==state)m.textContent=state}anim=requestAnimationFrame(run)}anim=requestAnimationFrame(run)
}catch(err){if(id!==rev)return;halt();$('mic').disabled=false;const messages={NotAllowedError:'マイクが許可されていません。Safariのサイト権限を確認してください。',NotFoundError:'マイクが見つかりません。',NotReadableError:'マイクを開けません。他のアプリの使用状況を確認してください。',OverconstrainedError:'マイクが必要な入力条件に対応していません。',SecurityError:'このページのマイク利用がブロックされています。'};m.textContent=messages[err.name]||err.message||'マイクを開始できませんでした。'}};
const player=$('media'),seek=$('seek'),play=$('play'),reset=$('reset');let objectURL=null, playbackSource, videoAnalyser, playbackAnim=0;

let importRevision=0, decoded=null, importState='idle', lastImportReason='', importCache=new Map(), offlinePending=null;
const importStatus=$('importStatus');
function setImportReason(x){if(x!==lastImportReason){importStatus.textContent=x;lastImportReason=x}}
function mp4AudioOnly(buf){
 const v=new DataView(buf), chars=i=>String.fromCharCode(...new Uint8Array(buf,i,4));
 function boxes(start,end){const out=[];for(let p=start;p+8<=end;){let n=v.getUint32(p),h=8;if(n===1){if(p+16>end)break;n=v.getUint32(p+8)*4294967296+v.getUint32(p+12);h=16}else if(!n)n=end-p;
 if(n<h||p+n>end||!Number.isSafeInteger(n))break;out.push({p,body:p+h,end:p+n,type:chars(p+4)});p+=n}return out}
 const outer=boxes(0,v.byteLength), moov=outer.find(x=>x.type==='moov');
 if(!outer.some(x=>x.type==='ftyp')||!moov||outer.some(x=>x.type==='moof'))return false;
 const tracks=[];
 for(const t of boxes(moov.body,moov.end).filter(x=>x.type==='trak')){
 const m=boxes(t.body,t.end).find(x=>x.type==='mdia');if(!m)continue;
 const h=boxes(m.body,m.end).find(x=>x.type==='hdlr');if(h&&h.body+12<=h.end)tracks.push([t,chars(h.body+8)])}
 if(!tracks.some(x=>x[1]==='soun'))return false;
 let changed=false;
 for(const [t,type] of tracks)if(type!=='soun'){v.setUint32(t.p+4,0x66726565);changed=true}
 return changed
}
function prepareImported(f){
 const id=++importRevision;decoded=null;importCache.clear();hist=[];importState='pending';setImportReason('素材から音声を読み取り中…');
 if(f.size>160*1024*1024){importState='fallback';setImportReason('再生しながら音声を解析します。');return offlinePending=null}
 const OC=window.OfflineAudioContext||window.webkitOfflineAudioContext;
 if(!OC){importState='fallback';setImportReason('再生しながら音声を解析します。');return offlinePending=null}
 const task=(async()=>{try{
 const c=new OC(1,1,SR);const original=await f.arrayBuffer();if(id!==importRevision)return;
 const trimmed=mp4AudioOnly(original);let buffer;
 try{buffer=await c.decodeAudioData(original)}catch(e){if(!trimmed)throw e;buffer=await c.decodeAudioData(await f.arrayBuffer())}
 if(id!==importRevision)return;if(!buffer.length||!buffer.numberOfChannels)throw Error();
 decoded={buffer,channels:Array.from({length:buffer.numberOfChannels},(_,i)=>buffer.getChannelData(i)),rate:buffer.sampleRate};importState='ready';setImportReason('素材の音声を読み取りました。')
 }catch(_){if(id===importRevision){importState='fallback';setImportReason('再生しながら音声を解析します。')}}})();
 task.finally(()=>{if(id===importRevision)syncExportEligibility()});
 return offlinePending=task
}
function analyseImported(time, analyser, arr, w){
 if(decoded){
 const bucket=Math.max(0,Math.round(time*1000/33));if(importCache.has(bucket))return importCache.get(bucket);
 const {rate,channels}=decoded,j0=Math.round(bucket*.033*rate-(N-1)*.5*rate/SR),ratio=rate/SR;let best=0,bestChannel=null;
 for(const ch of channels){let e=0;for(let i=0;i<N;i+=4){const k=Math.floor(j0+i*ratio);e+=(ch[k]??0)**2}if(e>=best){best=e;bestChannel=ch}}
 for(let i=0;i<N;i++){const j=j0+i*ratio,k=Math.floor(j),x=bestChannel?.[k]??0;w[i]=x+(j-k)*((bestChannel?.[k+1]??0)-x)}
 const a=withLevel(w);if(importCache.size>8500)importCache.clear();importCache.set(bucket,a);return a
 }
 if(!analyser||!ct||player.seeking||!arr)return {f:0,rms:0};
 analyser.getFloatTimeDomainData(arr);const ratio=ct.sampleRate/SR;
 for(let i=0;i<N;i++){const j=arr.length-1-(N-1-i)*ratio,k=Math.floor(j);w[i]=(arr[k]??0)+(j-k)*((arr[k+1]??arr[k]??0)-(arr[k]??0))}
 return withLevel(w)
}
function withLevel(w){let e=0;for(const x of w)e+=x*x;const rms=Math.sqrt(e/w.length);return {...feat(w),rms}}
function describeImported(a){
 if(importState==='pending'&&!a.rms)return setImportReason('素材から音声を読み取り中…');
 if(!a.f){
 if(!a.rms&&importState==='fallback')return setImportReason('この区間の音声を取得できません。無音でない場合は、AAC音声入りのMP4でお試しください。');
 return setImportReason(a.rms<.004?'この区間は無音または音が小さいため、判定を表示しません。':'この区間の音程を検出できません。')
 }
 if(a.rms<.015)return setImportReason('音程は検出しました。声種の判定には音量が足りません。');
 if(!classify(a.z,a.f))return setImportReason('音程は検出しました。声種が曖昧な区間は表示しません。');
 setImportReason('素材の音声を解析中')
}
function importedGraph(){if(!playbackSource){playbackSource=ct.createMediaElementSource(player);videoAnalyser=ct.createAnalyser();videoAnalyser.fftSize=8192;playbackSource.connect(videoAnalyser);videoAnalyser.connect(ct.destination)}}

const tstr=t=>Number.isFinite(t)?String(Math.floor(t/60)).padStart(2,'0')+':'+String(Math.floor(t%60)).padStart(2,'0'):'00:00';
function stopPlayback(){cancelAnimationFrame(playbackAnim);if(!player.paused)player.pause()}
$('playfile').onchange=e=>{const f=e.target.files[0];if(!f)return;if(/^image\//.test(f.type)||/\.(jpe?g|png|heic|heif|webp|gif|bmp|tiff?)$/i.test(f.name)){try{e.target.value=''}catch(_){}$('importStatus').textContent='写真には音が入っていないため、音程の表示には使えません。音声付きの動画か音声ファイルを選んでください。';return}try{e.target.value=''}catch(_){}stopPlayback();halt();prepareImported(f);display({f:0});$('msg').textContent='マイク停止中';$('mic').disabled=false;if(objectURL)URL.revokeObjectURL(objectURL);objectURL=URL.createObjectURL(f);player.src=objectURL;player.load();$('filename').textContent=f.name;play.disabled=reset.disabled=seek.disabled=true};
player.onloadedmetadata=()=>{play.disabled=reset.disabled=seek.disabled=false;seek.max=player.duration||1;player.parentElement.classList.toggle('tall',player.videoHeight>player.videoWidth)};
player.ontimeupdate=()=>{seek.value=player.currentTime;$('pos').textContent=tstr(player.currentTime)+' / '+tstr(player.duration)};
player.onerror=()=>{$('msg').textContent='この形式をSafariで開けません。'};
player.onpause=()=>{play.textContent='再生';cancelAnimationFrame(playbackAnim);display({f:0})};
seek.oninput=()=>{hist=[];player.currentTime=Number(seek.value)};
player.addEventListener('seeked',()=>{if(exportActive||!decoded)return;hist=[];const w=new Float32Array(N);let a;for(let i=4;i>=0;i--){a=analyseImported(Math.max(0,player.currentTime-i*.04),null,null,w);display(a)}describeImported(a)});
reset.onclick=()=>{stopPlayback();player.currentTime=0;display({f:0})};
play.onclick=async()=>{if(!player.paused){stopPlayback();return}halt();hist=[];$('mic').disabled=false;$('msg').textContent='マイク停止中';try{
const AC=window.AudioContext||window.webkitAudioContext;ct??=new AC();const resume=ct.resume();resume.catch(()=>{});
player.muted=false;if(!decoded)importedGraph();const playing=player.play();await Promise.all([resume,playing]);play.textContent='一時停止';
const arr=new Float32Array(8192),w=new Float32Array(N);let last=0,desc=0;function tick(t){if(player.paused)return;if(t-last>=40){last=t;
if(!player.seeking){const a=analyseImported(player.currentTime,videoAnalyser,arr,w);display(a);if(t-desc>=250){desc=t;describeImported(a)}}}
playbackAnim=requestAnimationFrame(tick)}playbackAnim=requestAnimationFrame(tick);
}catch(err){setImportReason('再生できません。 '+err.message)}};
const startMic=$('mic').onclick;$('mic').onclick=()=>{stopPlayback();return startMic()};

const exportBtn=$('exportVideo'), exportStatus=$('exportStatus'), saveBtn=$('saveVideo');
let exportActive=null, exportResult=null;
function forgetExport(){if(exportResult){URL.revokeObjectURL(exportResult.url);exportResult=null}saveBtn.hidden=true}
function syncExportEligibility(){exportBtn.disabled=!!exportActive||importState==='pending'||!Number.isFinite(player.duration)||!player.duration}
function exportControls(active){for(const el of [$('playfile'),play,reset,seek,$('mic')])el.disabled=active;if(active)exportBtn.disabled=true;else syncExportEligibility()}
player.addEventListener('loadedmetadata',()=>exportControls(false));
$('playfile').addEventListener('change',()=>{forgetExport();exportStatus.textContent='';exportBtn.disabled=true});
function makeExportCanvas(){
 const video=player.videoWidth>0&&player.videoHeight>0, ratio=video?player.videoWidth/player.videoHeight:16/9;
 const canvas=document.createElement('canvas');canvas.width=Math.max(2,2*Math.round(720*Math.min(1,ratio)/2));canvas.height=Math.max(2,2*Math.round(720/Math.max(1,ratio)/2));
 return canvas
}
function drawExport(canvas,field){
 const g=canvas.getContext('2d'), w=canvas.width,h=canvas.height, x=w*.05, y=h-Math.min(h*.32,w*.23)-h*.055, mw=w*.90,mh=h-h*.055-y;
 const text=(str,u,v,size,color,align='center')=>{g.font='600 '+size+'px system-ui, sans-serif';g.textAlign=align;g.textBaseline='middle';g.fillStyle=color;g.fillText(str,u,v)};
 const r=(a,b,c,d,k,paint)=>{g.fillStyle=paint;g.beginPath();g.roundRect(a,b,c,d,k);g.fill()};
 g.fillStyle='#000';g.fillRect(0,0,w,h);if(player.videoWidth&&player.readyState>=2)g.drawImage(player,0,0,w,h);
 r(x,y,mw,mh,Math.min(w*.018,mh*.14),'rgba(14,13,18,.80)');
 const cy=y+mh*.55,rh=Math.max(4,Math.min(w*.023,mh*.11)), grad=g.createLinearGradient(x,0,x+mw,0);
 grad.addColorStop(0,'#3bc4e0');grad.addColorStop(.5,'#a678ff');grad.addColorStop(1,'#ff8c6b');r(x,cy-rh/2,mw,rh,rh/2,grad);
 g.fillStyle='#ffffff69';for(let i=0;i<=4;i++)g.fillRect(x+mw*i/4,cy+rh,w*.002,mh*.08);
 const sm=Math.max(7,Math.min(w*.021,mh*.14));
 text('最低音 mid1E',x+4,y+mh*.85,sm,'#d8d4dc','left');text('最高音 hiD',x+mw-4,y+mh*.85,sm,'#d8d4dc','right');
 if(!field.opacity){for(const [i,k] of ['地声','ミックス','裏声'].entries())text(k,x+mw*(i+.5)/3,y+mh*.34,sm,'#ececef')}
 if(field.f){
 const pos=x+mw*Math.max(0,Math.min(1,(69+12*Math.log2(field.f/440)-52)/22)), radius=Math.min(w*.016,mh*.10), center=Math.max(w*.25,Math.min(w*.75,pos));
 g.fillStyle='#fff';g.fillRect(pos-1,cy-rh*1.45,2,rh*2.9);g.beginPath();g.arc(pos,cy,radius,0,2*Math.PI);g.fill();
 const size=Math.max(8,Math.min(w*.027,mh*.17));
 g.font='600 '+size+'px system-ui, sans-serif';const dw=g.measureText(field.pitch).width+6, lw=g.measureText('ミックス').width;
 text(field.pitch,center-(dw+lw)/2,y+mh*.13,size,'#fff','left');
 if(field.opacity){g.globalAlpha=field.opacity;text(field.label,center+(dw-lw)/2,y+mh*.13,size,'#f7b1d3','left');g.globalAlpha=1}
 }
}
function encoderType(){
 if(typeof MediaRecorder!=='function'||!HTMLCanvasElement.prototype.captureStream)return null;
 return ['video/mp4;codecs=avc1.42001f,mp4a.40.2','video/mp4','video/webm;codecs=vp8,opus','video/webm'].find(x=>MediaRecorder.isTypeSupported?.(x))||null;
}
exportBtn.onclick=async()=>{
 if(exportActive||!objectURL||!Number.isFinite(player.duration)||player.duration<=0)return;
 const type=encoderType();if(!type){exportStatus.textContent='このブラウザは音声付き動画の書き出しに対応していません。';return}
 forgetExport();stopPlayback();halt();hist=[];exportControls(true);exportStatus.textContent='書き出し準備中…';
 let rec,cap,destination,exportAudio,raf=0,timer=0,started=false,fatal='',completion=false;const chunks=[];
 const cleanup=()=>{cancelAnimationFrame(raf);clearInterval(timer);player.removeEventListener('ended',finish);player.removeEventListener('error',fail);document.removeEventListener('visibilitychange',visibility);stopPlayback();if(destination){try{exportAudio?.stop();exportAudio?.disconnect()}catch(_){};try{playbackSource?.disconnect(destination)}catch(_){};destination.stream.getTracks().forEach(t=>t.stop())}cap?.getTracks().forEach(t=>t.stop());exportActive=null;exportControls(false)};
 const fail=()=>end('素材の再生が中断されたため、書き出せませんでした。');
 const visibility=()=>{if(document.hidden)end('書き出しが中断されました。Safariを開いたまま、もう一度お試しください。')};
 const finish=()=>{completion=true;end('')};
 function end(err){if(err)fatal=err;if(started&&rec.state!=='inactive'){rec.stop()}else if(!started){cleanup();exportStatus.textContent=fatal||'書き出せませんでした。'}}
 exportActive={end};
 try{
 const AC=window.AudioContext||window.webkitAudioContext;ct??=new AC();const resumed=ct.resume();resumed.catch(()=>{});
 player.muted=false;
 destination=ct.createMediaStreamDestination();
 if(decoded){exportAudio=ct.createBufferSource();exportAudio.buffer=decoded.buffer;exportAudio.connect(destination)}
 else {importedGraph();playbackSource.connect(destination)}
 const canvas=makeExportCanvas();drawExport(canvas,{f:0});cap=canvas.captureStream(30);
 const both=new MediaStream([...cap.getVideoTracks(),...destination.stream.getAudioTracks()]);let actual=type;
 for(const option of [type,...['video/mp4','video/webm'].filter(k=>k!==type&&MediaRecorder.isTypeSupported(k))]){
  try{rec=new MediaRecorder(both,{mimeType:option,videoBitsPerSecond:2500000,audioBitsPerSecond:128000});actual=option;break}catch(_){}
 }
 if(!rec||both.getAudioTracks().length!==1||both.getVideoTracks().length!==1)throw Error('音声・映像の書き出し機能を開始できませんでした。');
 rec.ondataavailable=e=>{if(e.data.size)chunks.push(e.data)};
 rec.onerror=()=>end('動画エンコーダーでエラーが発生しました。');
 rec.onstop=()=>{cleanup();if(fatal||!completion||!chunks.length){exportStatus.textContent=fatal||'動画が生成されませんでした。';return}
 const mime=(chunks[0].type||rec.mimeType||actual).split(';')[0], ext=mime==='video/mp4'?'mp4':mime==='video/webm'?'webm':'';
 if(!ext){exportStatus.textContent='書き出した動画形式を確認できませんでした。';return}
 const original=$('filename').textContent.replace(/\.[^.]*$/,'').replace(/[/:*?"<>|]/g,'_')||'Pitch Meter';
 const f=new File(chunks,original+'-ピッチメーター.'+ext,{type:mime});
 exportResult={file:f,url:URL.createObjectURL(f)};
 saveBtn.hidden=false;exportStatus.textContent=ext.toUpperCase()+'の書き出しが完了しました。'};
 player.currentTime=0;player.addEventListener('ended',finish);player.addEventListener('error',fail);document.addEventListener('visibilitychange',visibility);
 rec.start(1000);started=true;const playing=player.play();await Promise.all([resumed,playing]);if(fatal||!exportActive)return;
 if(exportAudio)exportAudio.start(0,Math.min(player.currentTime,exportAudio.buffer.duration));
 const arr=new Float32Array(8192),w=new Float32Array(N),ratio=ct.sampleRate/SR;
 let last=-Infinity,fadeStart=-Infinity,wasShown=false,label='',field={f:0},lastMedia=player.currentTime,lastActivity=performance.now();
 timer=setInterval(()=>{if(player.currentTime!==lastMedia){lastMedia=player.currentTime;lastActivity=performance.now()}else if(performance.now()-lastActivity>10000)fail()},1000);
 function frame(t){if(fatal||completion||!exportActive)return;if(t-last>=33){last=t;const a=analyseImported(player.currentTime,videoAnalyser,arr,w);display(a);const shown=$('label').classList.contains('show');
 if(shown){label=$('label').textContent;fadeStart=Infinity}else if(wasShown){fadeStart=t}
 wasShown=shown;field={f:a.f,pitch:$('pitch').textContent,label,opacity:shown?1:Math.max(0,1-(t-fadeStart)/170)};
 drawExport(canvas,field);exportStatus.textContent='書き出し中 '+tstr(player.currentTime)+' / '+tstr(player.duration)+'。画面を開いたままお待ちください。'}
 raf=requestAnimationFrame(frame)}raf=requestAnimationFrame(frame);
 }catch(err){end(err.name==='NotAllowedError'?'再生が許可されませんでした。もう一度書き出しボタンを押してください。':err.message||'書き出しを開始できませんでした。')}
};
saveBtn.onclick=async()=>{
 if(!exportResult)return;const {file,url}=exportResult;
 if(navigator.canShare?.({files:[file]})){try{await navigator.share({files:[file]});return}catch(e){if(e.name==='AbortError')return}}
 const a=document.createElement('a');a.href=url;a.download=file.name;document.body.appendChild(a);a.click();a.remove();
};


const labels=$('labelsPage'), meterHome=$('meterHome'), labelPlayer=$('lblPlayer');
const labelPalette={'地声':'#65daca','裏声':'#f4adff','ミックス':'#ffb680','保留':'#b7afc5'};

const ARTISTS=[
 {id:'artist:fujiwara-satoshi',name:'Official髭男dism',voice:'藤原聡のサンプル'},
 {id:'artist:takenaka-yudai',name:'Novelbright',voice:'竹中雄大のサンプル'},
 {id:'artist:ishihara-shinya',name:'SaucyDog',voice:'石原慎也のサンプル'}
];
let activeArtist=null;
const artistById=id=>ARTISTS.find(x=>x.id===lRoleKey(id||''));
const sessionAudio=new Map(), knownArtists=new Map();
function artistCard(id){return $('artistCards').querySelector('[data-artist="'+id+'"]')}
function artistRows(id){return lrows.filter(r=>(artistById(r.singer)?.id||'manual')===id)}
function artistTracks(id){
 const rows=artistRows(id), list=new Map();
 for(const r of rows){const t=list.get(r.key)||{key:r.key,name:r.name,count:0};t.count++;list.set(r.key,t)}
 for(const f of knownArtists.values())if(f.artist===id&&!list.has(f.key))list.set(f.key,{...f,count:0});
 return [...list.values()].sort((a,b)=>a.name.localeCompare(b.name))
}
function artistTrackList(list,tracks,id){
 list.replaceChildren();for(const t of tracks){const line=document.createElement('li'),btn=document.createElement('button');btn.type='button';btn.textContent=t.name+'　'+t.count+'区間';btn.onclick=()=>{
 if(activeArtist!==id&&!switchArtist(id))return;
 const audio=sessionAudio.get(t.key);if(audio)openLabelFile(audio);else{linfo('「'+t.name+'」と同じ元ファイルを選び直すと編集を再開できます。');$('labelFile').click()}
 };line.append(btn);list.append(line)}
}
function showArtistCards(){
 for(const d of ARTISTS){const card=artistCard(d.id);if(!card)continue;const tracks=artistTracks(d.id);
 card.querySelector('.artistCount').textContent=tracks.length+' 音源・'+artistRows(d.id).length+' 区間'}
 if(activeArtist)artistTrackList($('artistDetailTracks'),artistTracks(activeArtist),activeArtist);
 $('manualArtistCount').textContent=artistRows('manual').length+' 区間'
}
function switchArtist(id){
 if(id===activeArtist)return true;
 ++lrev;lstop();lcancel();lready=null;lf=null;$('labelWorkspace').hidden=true;$('lblCommitStatus').textContent='';
 try{labelPlayer.removeAttribute('src');labelPlayer.load()}catch(_){}
 if(lsource){URL.revokeObjectURL(lsource);lsource=''}
 activeArtist=id;$('toMeter').hidden=!!id;$('artistCards').hidden=!!id;$('manualArtist').hidden=!!id;$('artistDetail').hidden=!id;
 if(!id){showArtistCards();return true}
 const artist=artistById(id);$('artistDetailMount').append($('artistEditor'));$('artistEditor').hidden=false;
 $('artistDetailTitle').textContent=artist?artist.name+' / '+artist.voice:'その他の音源・以前の下書き';
 $('lblSinger').readOnly=!!artist;$('lblSinger').value=artist?.id||'';
 $('artistLabelCountTitle').textContent=artist?artist.voice+'の区間':'その他の音源の区間';
 linfo('利用できる音源を選んで、区間を追加してください。');lrender();$('artistBack').focus();return true
}
(function buildArtists(){
 for(const a of ARTISTS){const card=document.createElement('article');card.dataset.artist=a.id;card.className='artistCard';
 const button=document.createElement('button');button.type='button';button.className='artistOpen';button.onclick=()=>switchArtist(a.id);
 const h=document.createElement('strong');h.textContent=a.name;const p=document.createElement('span');p.className='artistVoice';p.textContent=a.voice;
 const c=document.createElement('small');c.className='artistCount';button.append(h,p,c);card.append(button);$('artistCards').append(card)}
 $('openManualEditor').onclick=()=>switchArtist('manual');$('artistBack').onclick=()=>switchArtist(null);
})();

function lkind(kind){$('lblKind').value=kind;for(const btn of $('lblKinds').querySelectorAll('button'))btn.setAttribute('aria-pressed',String(btn.dataset.kind===kind))}
for(const btn of $('lblKinds').querySelectorAll('button'))btn.onclick=()=>{$('lblCommitStatus').textContent='';lkind(btn.dataset.kind)};

let lf=null, lsource='', lready=null, lrev=0, lrows=[], lseq=0, ledit=0, llow=0,lzoom=1, lstart=0,lend=1, lplay=0, lcsvURL='';
const lclamp=(n,a,b)=>Math.max(a,Math.min(b,n));
const lmilliseconds=n=>Math.round(n*1000)/1000;
function lformat(s){const ms=Math.max(0,Math.round(s*1000));return String(Math.floor(ms/60000)).padStart(2,'0')+':'+String(Math.floor(ms/1000)%60).padStart(2,'0')+'.'+String(ms%1000).padStart(3,'0')}
function lcell(v){let s=String(v??'');if(/^[\s\u0000-\u001f]*[=+@-]/u.test(s)||/^[\t\r\n]/u.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"'}
function lcsv(rows){return '\uFEFF歌い手ID,ファイル名,開始,終了,判定,伴奏,今回の用途で利用可,メモ\r\n'+rows.map(r=>[r.singer,r.name,lformat(r.start),lformat(r.end),r.kind,r.backing,r.allowed,r.memo].map(lcell).join(',')).join('\r\n')+'\r\n'}
function labelMode(on,nav=true){meterHome.hidden=on;labels.hidden=!on;document.querySelector('main').classList.toggle('labelsMode',on);document.documentElement.classList.toggle('labelsScrolling',on);
 if(on){stopPlayback();halt();$('mic').disabled=false;display({f:0});showArtistCards();requestAnimationFrame(ldraw)}else lstop();
 if(nav){const url=new URL(location.href);url.pathname=on?'/labels/':'/';url.searchParams.delete('mode');try{history.replaceState(null,'',url.pathname+url.search+url.hash)}catch(_){}}
}
$('toLabels').onclick=()=>{if(exportActive)return;labelMode(true)};
$('toMeter').onclick=()=>labelMode(false);
function linfo(s){$('labelsInfo').textContent=s}
function lstop(){life++;cancelAnimationFrame(lplay);labelPlayer.pause();readCursor();$('lblListen').textContent='再生'}
function lmax(){return lready?.duration||0}
function lwindow(){return lmax()/lzoom}
function lset(a,b){const max=lmax();if(!max)return;const min=Math.min(.005,max);lstart=lclamp(lmilliseconds(a),0,Math.max(0,max-min));lend=lclamp(lmilliseconds(b),lstart+min,max);
 $('lblStart').value=lstart.toFixed(3);$('lblEnd').value=lend.toFixed(3);ldraw()}
function lwave(buf){
 const n=Math.min(6400,buf.length), lo=new Float32Array(n),hi=new Float32Array(n), channels=Array.from({length:buf.numberOfChannels},(_,i)=>buf.getChannelData(i));
 for(let i=0;i<n;i++){const a=Math.floor(i*buf.length/n),b=Math.max(a+1,Math.floor((i+1)*buf.length/n));let m=0,x=0;const step=Math.max(1,Math.ceil((b-a)/160));for(const c of channels)for(let j=a;j<b;j+=step){m=Math.min(m,c[j]);x=Math.max(x,c[j])}lo[i]=m;hi[i]=x}
 const scale=Math.max(.06,...hi,...lo.map(x=>-x));return {lo,hi,scale}
}
function ldraw(){
 if(!lready||labels.hidden)return;const span=lwindow(), hi=llow+span,c=$('lblWave'),r=c.getBoundingClientRect();if(!r.width||!span)return;
 const dpr=Math.min(2,window.devicePixelRatio||1),W=Math.round(r.width*dpr),H=Math.round(r.height*dpr);if(c.width!==W)c.width=W;if(c.height!==H)c.height=H;
 const g=c.getContext('2d');if(!g)return;const x=t=>((t-llow)/span)*W;const k=t=>lclamp(x(t),0,W);
 g.clearRect(0,0,W,H);g.fillStyle='#101016';g.fillRect(0,0,W,H);
 for(const row of lrows.filter(v=>v.key===lf?.key)){const a=k(row.start),b=k(row.end);g.globalAlpha=.38;g.fillStyle=labelPalette[row.kind];g.fillRect(a,H*.74,b-a,H*.20)}g.globalAlpha=1;
 g.fillStyle='rgba(243,160,204,.2)';g.fillRect(k(lstart),0,k(lend)-k(lstart),H);
 const peaks=lready.peaks;if(peaks){g.fillStyle='#d5baca';const mid=H*.47;for(let i=0;i<W;i++){const n=Math.min(peaks.lo.length-1,Math.floor((llow+i/W*span)/lmax()*peaks.lo.length));g.fillRect(i,mid-peaks.hi[n]/peaks.scale*H*.37,1,Math.max(1,(peaks.hi[n]-peaks.lo[n])/peaks.scale*H*.37))}}
 for(const [id,t,color] of [['lblStartHandle',lstart,'#ffc3db'],['lblEndHandle',lend,'#c8b6f6']]){const p=k(t);$(id).style.left=(100*p/W)+'%';$(id).setAttribute('aria-description',lformat(t));g.fillStyle=color;g.fillRect(p,0,Math.max(1,dpr),H)}
 {const p=Math.min(W-1,k(lcursor));g.fillStyle='#f6df89';g.globalAlpha=lcursor>=llow&&lcursor<=hi?1:.5;g.fillRect(p,0,Math.max(1,dpr),H);g.globalAlpha=1}
 $('waveLo').textContent=lformat(llow);$('waveHi').textContent=lformat(hi)
}
function lscroll(){const el=$('lblScroll');el.max=Math.max(0,lmax()-lwindow()).toFixed(3);el.disabled=+el.max<=0;llow=lclamp(llow,0,+el.max);el.value=String(llow)}
function lcenter(){llow=lclamp((lstart+lend-lwindow())/2,0,Math.max(0,lmax()-lwindow()));lscroll();ldraw()}
function lcancel(){ledit=0;$('lblCommit').textContent='選択区間反映';$('lblCancel').hidden=true;$('lblNote').value=''}
$('lblCancel').onclick=lcancel;
function lrender(){
 const ul=$('lblRows');ul.replaceChildren();const current=artistRows(activeArtist||'manual');showLearnCoverage();$('lblCount').textContent=current.length;$('lblCSV').disabled=!lrows.length;showArtistCards();
 for(const row of current){const li=document.createElement('li');li.style.setProperty('--tag',labelPalette[row.kind]);const head=document.createElement('strong');head.textContent=row.kind+' '+lformat(row.start)+' 〜 '+lformat(row.end);const f=document.createElement('small');f.textContent=[row.singer,row.name,row.role,row.backing,row.allowed,row.memo].filter(Boolean).join(' / ');
 const edit=document.createElement('button');edit.type='button';edit.textContent='編集';edit.disabled=row.key!==lf?.key;
 edit.onclick=()=>{lstop();ledit=row.id;$('lblSinger').value=row.singer;$('lblBacking').value=row.backing;$('lblAllowed').value=row.allowed;$('lblRole').value=row.role;lkind(row.kind);$('lblNote').value=row.memo;lset(row.start,row.end);lcenter();$('lblCommit').textContent='選択区間反映';$('lblCancel').hidden=false;$('lblStart').focus()};
 const del=document.createElement('button');del.type='button';del.textContent='削除';del.onclick=()=>{lrows=lrows.filter(r=>r.id!==row.id);if(ledit===row.id)lcancel();lrender();ldraw();lsaveDraft();linfo('区間を1件削除しました。適用済みの基準から除くには初期基準に戻すか、残す区間で反映し直してください。')};
 li.append(head,f,edit,del);ul.append(li)}
}

function labelRead(file){if(typeof file.arrayBuffer==='function')return file.arrayBuffer();return new Promise((resolve,reject)=>{const fr=new FileReader();fr.onload=()=>resolve(fr.result);fr.onerror=()=>reject(fr.error);fr.readAsArrayBuffer(file)})}
function labelType(raw,name){const b=new Uint8Array(raw),s=(p,n)=>String.fromCharCode(...b.subarray(p,p+n));
 if(s(0,4)==='RIFF'&&s(8,4)==='WAVE')return 'audio/wav';
 if(s(4,4)==='ftyp')return 'audio/mp4';
 if(s(0,4)==='fLaC')return 'audio/flac';
 if(s(0,4)==='FORM'&&['AIFF','AIFC'].includes(s(8,4)))return 'audio/aiff';
 if(s(0,3)==='ID3'||/\.mp3$/i.test(name))return 'audio/mpeg';
 if(/\.aac$/i.test(name))return 'audio/aac';return ''
}
function labelNativeDuration(el,rev){if(el.readyState>=1&&Number.isFinite(el.duration))return Promise.resolve(el.duration);
 return new Promise(resolve=>{const finish=()=>{clearTimeout(timer);el.removeEventListener('loadedmetadata',finish);el.removeEventListener('error',finish);resolve(rev===lrev&&Number.isFinite(el.duration)?el.duration:0)};const timer=setTimeout(finish,4200);el.addEventListener('loadedmetadata',finish);el.addEventListener('error',finish)})}
function labelWebDecode(raw,rate){
 const OC=window.OfflineAudioContext||window.webkitOfflineAudioContext;if(!OC)return Promise.reject(Error('ブラウザの音声デコーダーを使えません。'));
 return new Promise((resolve,reject)=>{try{const c=new OC(1,128,rate);const p=c.decodeAudioData(raw.slice(0),resolve,reject);if(p&&typeof p.then==='function')p.then(resolve,reject)}catch(e){reject(e)}})
}
function labelPcmWav(raw){
 if(labelType(raw,'')!=='audio/wav')return null;const d=new DataView(raw),tag=i=>String.fromCharCode(...new Uint8Array(raw,i,4));let fmt=null,data=null;
 for(let p=12;p+8<=d.byteLength;){const sz=d.getUint32(p+4,true),b=p+8;if(sz>d.byteLength-b)break;const k=tag(p);
 if(k==='fmt '&&sz>=16){const a=d.getUint16(b,true),sub=a===65534&&sz>=40?d.getUint16(b+24,true):a;fmt={sub,ch:d.getUint16(b+2,true),rate:d.getUint32(b+4,true),align:d.getUint16(b+12,true),bits:d.getUint16(b+14,true)}}
 if(k==='data')data={b,sz};p=b+sz+(sz%2)}
 if(!data||!fmt)return null;const {sub,ch,rate,align,bits}=fmt,step=bits/8,n=Math.floor(data.sz/align);
 if(!(rate>=8000&&rate<=192000&&ch>=1&&ch<=8&&n>=Math.floor(rate*.01)&&Number.isFinite(n)&&align>=step*ch&&n*ch<=24e6&&((sub===1&&[8,16,24,32].includes(bits))||(sub===3&&bits===32))))return null;
 const out=Array.from({length:ch},()=>new Float32Array(n));
 for(let i=0;i<n;i++)for(let c=0;c<ch;c++){const p=data.b+i*align+c*step;let x;
 if(sub===3)x=d.getFloat32(p,true);else if(bits===8)x=(d.getUint8(p)-128)/128;else if(bits===16)x=d.getInt16(p,true)/32768;else if(bits===32)x=d.getInt32(p,true)/2147483648;else{const v=d.getUint8(p)|d.getUint8(p+1)<<8|d.getUint8(p+2)<<16;x=((v<<8)>>8)/8388608}
 out[c][i]=Number.isFinite(x)?Math.max(-1,Math.min(1,x)):0}
 return {duration:n/rate,sampleRate:rate,length:n,numberOfChannels:ch,getChannelData:c=>out[c]}
}

$('labelFile').onchange=async e=>{
 const f=e.currentTarget?.files?.[0]||e.target?.files?.[0];if(!f)return;
 const input=e.currentTarget||e.target;try{input.value=''}catch(_){}
 return openLabelFile(f)
};
async function openLabelFile(f){
 const artist=activeArtist??'manual',id=++lrev;let stage='ファイル';$('lblCommitStatus').textContent='';
 lstop();lcancel();lready=null;lcursor=0;lqueued=null;lmode='normal';lauditionEnd=0;
 if(lsource){labelPlayer.removeAttribute('src');labelPlayer.load();URL.revokeObjectURL(lsource);lsource=''}
 lf=null;$('labelWorkspace').hidden=true;linfo('音声を読み取り中…');lrender();
 try{
 if(!f.size)throw Error('このファイルは空です。');
 if(f.size>160*1024*1024)throw Error('160MB以下の音声ファイルを選んでください。');
 const raw=await labelRead(f);if(id!==lrev)return;
 stage='照合';const key=await lhash(raw);if(id!==lrev)return;
 const tagged=lrows.find(r=>r.key===key);const known=knownArtists.get(key);if((tagged&&(artistById(tagged.singer)?.id||'manual')!==artist)||(known&&known.artist!==artist))throw Error('このファイルは別のサンプル欄に登録済みです。元の欄から開いてください。');
 stage='音声デコード';const type=labelType(raw,f.name);
 const mime=type||((f.type==='application/octet-stream'||!f.type)?'':f.type);
 lsource=URL.createObjectURL(mime&&mime!==f.type?new Blob([raw],{type:mime}):f);labelPlayer.src=lsource;labelPlayer.load();
 let buf;
 try{buf=await labelWebDecode(raw,16000)}catch(_){if(id!==lrev)return;try{buf=await labelWebDecode(raw,44100)}catch(_){buf=labelPcmWav(raw)}}
 if(id!==lrev)return;
 const duration=buf?.duration||await labelNativeDuration(labelPlayer,id);if(id!==lrev)return;
 if(!Number.isFinite(duration)||duration<.01)throw Error('Safariでこの音声を開けません。WAV、M4A（AAC）、MP3などをお試しください。');
 const prior=lrows.find(r=>r.key===key);if(prior&&Math.abs(prior.duration-duration)>.10)throw Error('録音の長さが下書きと一致しません。');
 lf={key,name:prior?.name||f.name,size:f.size,duration:prior?.duration||duration};sessionAudio.set(key,f);knownArtists.set(key,{key,name:lf.name,artist});$('lblSinger').value=artistById(artist)?.id||prior?.singer||'';$('lblBacking').value=prior?.backing||'不明';$('lblAllowed').value=prior?.allowed||'未確認';$('lblRole').value=prior?.role||'未指定';
 stage='波形表示';let peaks=null;if(buf)try{peaks=lwave(buf)}catch(_){}
 lready={duration,peaks,buffer:buf||null};if(prior&&buf)lrefreshRecordFeatures(prior);
 $('labelWorkspace').hidden=false;$('labelsFileName').textContent=f.name;$('lblDuration').textContent=lformat(duration);$('lblEnd').max=duration;$('lblStart').max=duration;
 llow=0;lzoom=1;lscroll();lset(0,Math.min(1,duration));zoomDisplay();syncCursor();lrender();
 linfo(peaks?'区間を選び、判定を付けて「区間を追加」を押してください。':'再生と時刻のラベル付けはできます。この形式の波形・判定への反映にはWAVまたはM4A（AAC）をお試しください。');
 }catch(err){if(id!==lrev)return;const m=String(err?.message||'');linfo(/^(このファイルは空|このファイルは別|160MB|Safariでこの音声|録音の長さ)/.test(m)?m:'読み込みの「'+stage+'」で問題が起きました。ファイルを選び直すか、WAVまたはM4A（AAC）をお試しください。')}
};
$('lblZoom').onchange=e=>{lzoom=Number(e.target.value);lcenter()};
$('lblScroll').oninput=e=>{llow=Number(e.target.value);ldraw()};
window.addEventListener('resize',()=>requestAnimationFrame(ldraw));
function lmove(which,next){$('lblCommitStatus').textContent='';if(which==='start')lset(Math.min(next,lend-.005),lend);else lset(lstart,Math.max(lstart+.005,next))}
function lhandle(id,which){const el=$(id);let p=null,offset=0;
 const time=x=>{const r=$('lblTimeline').getBoundingClientRect();return llow+lclamp((x-r.left)/r.width,0,1)*lwindow()};
 el.addEventListener('pointerdown',e=>{if(!lready||p!==null||e.button!==0||wmulti)return;e.preventDefault();lstop();p=e.pointerId;offset=(which==='start'?lstart:lend)-time(e.clientX);el.setPointerCapture(p)});
 el.addEventListener('pointermove',e=>{if(e.pointerId===p&&!wmulti)lmove(which,time(e.clientX)+offset)});
 for(const k of ['pointerup','pointercancel','lostpointercapture'])el.addEventListener(k,e=>{if(e.pointerId===p)p=null});
 el.onkeydown=e=>{if(!['ArrowLeft','ArrowRight'].includes(e.key)||!lready)return;e.preventDefault();lstop();lmove(which,(which==='start'?lstart:lend)+(e.key==='ArrowRight'?1:-1)*(e.shiftKey?.1:.01))};
}
lhandle('lblStartHandle','start');lhandle('lblEndHandle','end');
function lapplyInputs(){const aa=$('lblStart'),bb=$('lblEnd'),a=aa.valueAsNumber,b=bb.valueAsNumber;if(!Number.isFinite(a)||!Number.isFinite(b)||a<0||b<=a||b>lmax()+.00051){linfo('開始より後、素材の長さ以内の終了時刻を入力してください。');return false}lset(a,b);return true}
$('lblStart').onchange=$('lblEnd').onchange=()=>{lstop();if(lapplyInputs())lcenter()};
async function wavePlay(restartRange=false){
 if(!lready)return;if(!restartRange&&!labelPlayer.paused){lstop();return}
 if(restartRange){if(!lapplyInputs())return;lstop();lmode='range';lauditionEnd=lend;moveCursor(lstart,true)}
 else if(lcursor>=lmax()-.001){lmode='normal';moveCursor(0,true)}
 const rev=lrev,playRev=++life;
 try{const r=labelPlayer.play();await r;if(playRev!==life)return;if(rev!==lrev||labels.hidden)return lstop();$('lblListen').textContent='一時停止';
 const tick=()=>{if(labelPlayer.paused||playRev!==life)return;if(lmode==='range'&&labelPlayer.currentTime>=lauditionEnd){lstop();moveCursor(lauditionEnd);lmode='normal';return}readCursor();lplay=requestAnimationFrame(tick)};lplay=requestAnimationFrame(tick)}
 catch(_){if(playRev===life)linfo('この音声を再生できませんでした。')}
}
$('lblListen').onclick=()=>wavePlay();
$('lblRangeListen').onclick=()=>wavePlay(true);
labelPlayer.onended=()=>{lstop();lmode='normal';readCursor()};
let lcursor=0,lqueued=null,life=0,lmode='normal',lauditionEnd=0;
const scrub=$('lblScrub'),wave=$('lblTimeline');
function syncCursor(){
 scrub.setAttribute('aria-valuemax',lmax().toFixed(3));scrub.setAttribute('aria-valuenow',lcursor.toFixed(3));scrub.setAttribute('aria-valuetext',lformat(lcursor));
 $('lblScrubHead').style.left=(lmax()?lcursor/lmax()*100:0)+'%';$('lblCursorTime').textContent=lformat(lcursor);
 const marks=$('lblScrubMarks').children;for(let i=0;i<marks.length;i++)marks[i].textContent=lformat(lmax()*i/(marks.length-1))
}
function readCursor(){if(lqueued===null&&lready&&Number.isFinite(labelPlayer.currentTime)){lcursor=lclamp(labelPlayer.currentTime,0,lmax());syncCursor();ldraw()}}
function moveCursor(t, reveal=false){
 if(!lready)return;lcursor=lclamp(lmilliseconds(t),0,lmax());lqueued=lcursor;
 try{if(labelPlayer.readyState>=1){labelPlayer.currentTime=lcursor;lqueued=null}}catch(_){}
 if(reveal&&(lcursor<llow||lcursor>llow+lwindow())){llow=lcursor-lwindow()/2;lscroll()}
 syncCursor();ldraw()
}
labelPlayer.addEventListener('loadedmetadata',()=>{if(lqueued!==null)moveCursor(lqueued)});
for(const e of ['timeupdate','seeked','pause'])labelPlayer.addEventListener(e,readCursor);
scrub.onkeydown=e=>{if(!lready)return;const step=e.shiftKey?1:.1;const t={ArrowLeft:lcursor-step,ArrowDown:lcursor-step,ArrowRight:lcursor+step,ArrowUp:lcursor+step,Home:0,End:lmax()}[e.key];if(t===undefined)return;e.preventDefault();lstop();lmode='normal';moveCursor(t,true)};
const wtouch=new Map();let wmulti=false,wbase=null,wselection=null;
function zoomDisplay(){
 const sel=$('lblZoom'), custom=$('lblZoomCustom');const near=[1,2,4,8,16].find(x=>Math.abs(x-lzoom)<.015);
 if(near){custom.hidden=true;sel.value=String(near)}else{custom.hidden=false;custom.textContent=lzoom.toFixed(1)+'×';sel.value='custom'}
}
function pairGeo(r){
 const [a,b]=Array.from(wtouch.values());return {gap:Math.max(12,Math.hypot(a.x-b.x,a.y-b.y)),frac:lclamp(((a.x+b.x)/2-r.left)/r.width,0,1)}
}
wave.addEventListener('pointerdown',e=>{
 if(e.pointerType!=='touch'||!lready)return;
 if(!wtouch.size)wselection=[lstart,lend];wtouch.set(e.pointerId,{x:e.clientX,y:e.clientY});
 if(wtouch.size===2){wmulti=true;cancelWaveHead();const r=wave.getBoundingClientRect(),p=pairGeo(r);wbase={gap:p.gap,zoom:lzoom,anchor:llow+p.frac*lwindow()};if(wselection)lset(...wselection)}
 if(!e.target.closest?.('.lblHandle'))try{wave.setPointerCapture(e.pointerId)}catch(_){}
 },true);
wave.addEventListener('pointermove',e=>{
 if(!wtouch.has(e.pointerId))return;wtouch.set(e.pointerId,{x:e.clientX,y:e.clientY});if(wtouch.size!==2||!wbase)return;
 const r=wave.getBoundingClientRect();if(!r.width)return;
 const p=pairGeo(r);lzoom=lclamp(wbase.zoom*p.gap/wbase.gap,1,16);llow=wbase.anchor-p.frac*lwindow();lscroll();zoomDisplay();ldraw()
 },true);
for(const n of ['pointerup','pointercancel','lostpointercapture'])wave.addEventListener(n,e=>{
 if(!wtouch.delete(e.pointerId))return;wbase=null;if(!wtouch.size){wmulti=false;wselection=null}
 },true);


function installHeadGesture(surface,view,blocked=()=>false){
 let g=null;
 const cancel=()=>{if(g)clearTimeout(g.hold);g=null;surface.classList.remove('headHeld')};
 const at=(x,v)=>v.lo+lclamp((x-v.r.left)/v.r.width,0,1)*v.span;
 const delta=(p,e)=>Math.hypot(e.clientX-p.x,e.clientY-p.y);
 surface.addEventListener('pointerdown',e=>{
 if(!lready||e.button!==0||e.target.closest?.('.lblHandle'))return;
 if(blocked()||e.isPrimary===false||g){cancel();return}
 const v=view();if(!v.r.width||!v.span)return;
 const w=(lcursor-v.lo)/v.span,px=v.r.left+w*v.r.width;
 const near=w>=0&&w<=1&&Math.abs(e.clientX-px)<=20;
 const p={id:e.pointerId,x:e.clientX,y:e.clientY,hold:null,armed:false,offset:0};g=p;
 try{surface.setPointerCapture(e.pointerId)}catch(_){}
 if(near)p.hold=setTimeout(()=>{if(g!==p||blocked())return;lstop();lmode='normal';p.armed=true;p.offset=lcursor-at(p.x,view());surface.classList.add('headHeld')},300)
 },true);
 surface.addEventListener('pointermove',e=>{
 if(!g||e.pointerId!==g.id)return;if(blocked()){cancel();return}
 if(!g.armed){if(delta(g,e)>10)cancel();return}
 if(e.cancelable)e.preventDefault();moveCursor(at(e.clientX,view())+g.offset)
 },true);
 surface.addEventListener('pointerup',e=>{
 if(!g||e.pointerId!==g.id)return;const p=g;cancel();if(blocked()||p.armed||delta(p,e)>10)return;
 const v=view();if(!v.r.width||!v.span)return;lstop();lmode='normal';moveCursor(at(e.clientX,v),surface===scrub)
 },true);
 for(const n of ['pointercancel','lostpointercapture'])surface.addEventListener(n,e=>{if(g?.id===e.pointerId)cancel()},true);
 surface.addEventListener('contextmenu',e=>{if(g?.armed)e.preventDefault()});
 return cancel
}
const cancelWaveHead=installHeadGesture(wave,()=>({r:wave.getBoundingClientRect(),lo:llow,span:lwindow()}),()=>wmulti);
installHeadGesture(scrub,()=>({r:scrub.getBoundingClientRect(),lo:0,span:lmax()}));
// Limit the legacy WebKit gesture fallback to these waveform controls.
for(const surface of [wave,scrub]){
 let origin=null;
 for(const event of ['selectstart','contextmenu'])surface.addEventListener(event,e=>{if(e.cancelable)e.preventDefault()});
 surface.addEventListener('touchstart',e=>{if(e.touches.length===1)origin={x:e.touches[0].clientX,y:e.touches[0].clientY}},{passive:true});
 surface.addEventListener('touchmove',e=>{
 if(!lready||!e.cancelable)return;const t=e.touches[0];
 if(e.touches.length>1||surface.classList.contains('headHeld')||e.target.closest?.('.lblHandle')||
   (t&&origin&&Math.abs(t.clientX-origin.x)>Math.max(6,Math.abs(t.clientY-origin.y))))e.preventDefault()
 },{passive:false});
 for(const event of ['touchend','touchcancel'])surface.addEventListener(event,e=>{if(!e.touches.length)origin=null},{passive:true})
}


$('lblCommit').onclick=()=>{$('lblCommitStatus').textContent='';if(!lready||!lapplyInputs())return;const singer=artistById(activeArtist)?.id||$('lblSinger').value.trim();if(activeArtist==='manual'&&artistById(singer)){linfo('この歌い手IDは専用サンプル欄で使用してください。');return}if(!singer){linfo('歌い手IDを入力してください。');$('lblSinger').focus();return}
 const row={id:ledit||++lseq,...lf,singer,start:lstart,end:lend,kind:$('lblKind').value,backing:$('lblBacking').value,allowed:$('lblAllowed').value,role:$('lblRole').value,memo:$('lblNote').value.trim()};
 const outside=lrows.filter(r=>r.key!==lf.key);try{lcoherent([...outside,row]);if(lrows.length>=lMaxRows&&!ledit)throw Error('このプロジェクトの上限は5,000区間です。')}catch(err){linfo(err.message);return}
 const i=lrows.findIndex(r=>r.id===row.id);if(i<0)lrows.push(row);else lrows[i]=row;
 for(const r of lrows)if(r.key===lf.key){r.singer=row.singer;r.backing=row.backing;r.allowed=row.allowed;r.role=row.role}lrefreshRecordFeatures(row);
 lrows.sort((a,b)=>a.name.localeCompare(b.name)||a.start-b.start);linfo(i<0?'区間を追加しました。':'編集を保存しました。');lcancel();lrender();ldraw();$('lblCommitStatus').textContent=lsaveDraft()?'反映完了':'このタブに反映しました。保存できませんでした。'
};
$('lblCSV').onclick=async()=>{if(!lrows.length)return;const file=new File([lcsv(lrows)],'pitch-meter-voice-labels.csv',{type:'text/csv;charset=utf-8'});
 if(navigator.canShare?.({files:[file]})){try{await navigator.share({files:[file]});return}catch(e){if(e.name==='AbortError')return}}
 if(lcsvURL)URL.revokeObjectURL(lcsvURL);lcsvURL=URL.createObjectURL(file);const a=document.createElement('a');a.href=lcsvURL;a.download=file.name;document.body.append(a);a.click();a.remove()
};



const lDraftKey='pm_label_project_v1', lbRoles=['未指定','判定基準用','テスト専用'], lMaxRows=5000;
const lRoleKey=s=>s.trim().normalize('NFKC').toLowerCase();
const lfields=['key','name','size','duration','singer','start','end','kind','backing','allowed','role','memo'];
function lplain(row){return Object.fromEntries(lfields.map(k=>[k,row[k]]))}
function lproject(rows=lrows){return {format:'pitch-meter-voice-labels',version:1,rows:rows.map(lplain)}}
function lcoherent(rows){
 const singer=new Map(),rec=new Map();
 for(const r of rows){const id=lRoleKey(r.singer);
  if(r.role!=='未指定'){const p=singer.get(id);if(p&&p!==r.role)throw Error('同じ歌い手IDに違う用途が設定されています。');singer.set(id,r.role)}
  const signature=JSON.stringify([r.size,r.duration,id,r.backing,r.allowed,r.role]);const p=rec.get(r.key);
  if(p&&p!==signature)throw Error('同じ録音の歌い手、用途、許可などの設定が一致しません。');rec.set(r.key,signature);
 }
 return rows
}
function lvalidProject(data){
 if(!data||data.format!=='pitch-meter-voice-labels'||data.version!==1||!Array.isArray(data.rows)||data.rows.length>lMaxRows)throw Error('このファイルは対応するプロジェクトJSONではありません。');
 const rows=data.rows.map(r=>{
 const t=(s,n)=>typeof s==='string'&&s.length<=n,nn=x=>typeof x==='number'&&Number.isFinite(x);
 if(!r||!t(r.key,71)||!/^sha256:[0-9a-f]{64}$/.test(r.key)||!t(r.name,512)||!r.name||!t(r.singer,90)||!r.singer.trim()||!t(r.memo,400)||
  !Number.isInteger(r.size)||r.size<1||r.size>160*1024*1024||!nn(r.duration)||r.duration<.01||!nn(r.start)||!nn(r.end)||r.start<0||r.end<=r.start||r.end>r.duration+.00051||
  !Object.hasOwn(labelPalette,r.kind)||!['不明','なし','あり'].includes(r.backing)||!['未確認','可','不可'].includes(r.allowed)||!lbRoles.includes(r.role))throw Error('プロジェクト内の区間データが無効です。');
 return lplain(r)
 });
 return lcoherent(rows)
}
function lsaveDraft(){
 const msg=$('lblDraftStatus');
 let saved=true;try{localStorage.setItem(lDraftKey,JSON.stringify(lproject()));msg.textContent='下書き '+lrows.length+' 区間をこのSafariに保存。サイトデータを消すと失われるので、JSONも保存してください。'}
 catch(_){saved=false;msg.textContent='Safariに下書きを保存できません。タブを閉じる前にプロジェクトJSONを保存してください。'}
 $('lblBackup').disabled=!lrows.length;return saved
}
function lbootDraft(){
 try{const raw=localStorage.getItem(lDraftKey);if(!raw)return;
 const rows=lvalidProject(JSON.parse(raw));lrows=rows.map(r=>({...r,id:++lseq}));$('lblDraftStatus').textContent='下書き '+lrows.length+' 区間を読み込みました。波形・再生・反映には同じ録音を選び直してください。';
 $('lblBackup').disabled=!lrows.length;lrender()
 }catch(_){$('lblDraftStatus').textContent='下書きを読み込めませんでした。保存したプロジェクトJSONがあれば読み込めます。'}
}
async function lhash(buf){return 'sha256:'+Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',buf)),x=>x.toString(16).padStart(2,'0')).join('')}
let lbackupURL='';
async function lsaveBackup(file){
 if(navigator.canShare?.({files:[file]})){try{await navigator.share({files:[file]});return}catch(e){if(e.name==='AbortError')return}}
 if(lbackupURL)URL.revokeObjectURL(lbackupURL);lbackupURL=URL.createObjectURL(file);const a=document.createElement('a');a.href=lbackupURL;a.download=file.name;document.body.append(a);a.click();a.remove()
}
$('lblBackup').onclick=()=>{if(lrows.length)lsaveBackup(new File([JSON.stringify(lproject(),null,2)],'pitch-meter-label-project.json',{type:'application/json'}))};
$('lblRestore').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;
 try{if(f.size>8*1024*1024)throw Error('プロジェクトJSONは8MB以下にしてください。');
 const rows=lvalidProject(JSON.parse(await f.text())), prior=lrows.map(lplain), seen=new Set(prior.map(v=>JSON.stringify(v)));
 const extra=[];for(const r of rows){const k=JSON.stringify(r);if(!seen.has(k)){extra.push(r);seen.add(k)}}
 if(prior.length+extra.length>lMaxRows)throw Error('このプロジェクトの上限は5,000区間です。');
 lcoherent([...prior,...extra]);lrows.push(...extra.map(r=>({...r,id:++lseq})));lrender();ldraw();lsaveDraft();
 linfo(extra.length+' 区間を復元しました。音声は含まれていません。波形・再生・反映には同じ録音を選び直してください。')
 }catch(err){linfo(err instanceof SyntaxError?'プロジェクトJSONを読み込めませんでした。':err.message)}
};

const lmodelKey='pm_label_voice_model_v2';
const coverageKey='pm_label_coverage_v1', useStatuses=['used','role','permission','hold','original','audioQuality'];
let appliedGroups=null;
const statusWords={used:'使用可能',role:'用途が判定基準用でない',permission:'利用可でない',hold:'保留',original:'元音声の再選択・デコードが必要',audioQuality:'有効な音声区間が不足'};
function learnStatus(r){
 if(r.role!=='判定基準用')return 'role';if(r.allowed!=='可')return 'permission';if(!learnClasses.includes(r.kind))return 'hold';if(!r.featureKey)return 'original';if(!r.features)return 'audioQuality';return 'used'
}
function learnCoverage(rows=lrows){
 const groups=Object.fromEntries([...ARTISTS.map(a=>a.id),'manual'].map(id=>[id,{counts:Object.fromEntries(useStatuses.map(x=>[x,0])),classes:Object.fromEntries(learnClasses.map(x=>[x,0]))}]));
 for(const row of rows){const id=artistById(row.singer)?.id||'manual', p=groups[id],status=learnStatus(row);p.counts[status]++;if(status==='used')p.classes[row.kind]++}
 return groups
}
function showLearnCoverage(){
 const a=$('lblLearnCoverage'), b=$('lblLearnSnapshot');a.replaceChildren();b.replaceChildren();
 const pending=learnCoverage(), names=[...ARTISTS.map(a=>[a.id,a.name]),['manual','その他']];
 const line=(out,text)=>{const e=document.createElement('li');e.textContent=text;out.append(e)};
 for(const [id,name] of names){const p=pending[id], hit=p.counts.used, cls=learnClasses.filter(k=>p.classes[k]).map(k=>k+' '+p.classes[k]).join('・');
 const excluded=useStatuses.filter(k=>k!=='used'&&p.counts[k]).map(k=>statusWords[k]+' '+p.counts[k]).join('、');
 line(a,name+'：使用可能 '+hit+'区間'+(cls?'（'+cls+'）':'')+(excluded?' ／ 除外・未準備 '+excluded:''))}
 if(!appliedTotals){line(b,'まだ判定基準に反映されていません。');return}
 if(!appliedGroups){line(b,'前回の適用データは声種別の合計だけです。アーティスト別の内訳は次の適用時から表示します。');for(const k of learnClasses)if(appliedTotals[k])line(b,k+' '+appliedTotals[k].n+'区間');return}
 for(const [id,name] of names){const c=appliedGroups[id];const fields=learnClasses.filter(k=>c?.[k]>0).map(k=>k+' '+c[k]);line(b,name+'：'+(fields.length?fields.join('・'):'0区間'))}
}
function saveCoverage(totals){
 const coverage=learnCoverage();appliedGroups=Object.fromEntries(Object.entries(coverage).map(([id,p])=>[id,p.classes]));
 try{localStorage.setItem(coverageKey,JSON.stringify({tag:JSON.stringify(totals),groups:appliedGroups}))}catch(_){}
}
function loadCoverage(totals){
 if(!totals)return null;try{const rec=JSON.parse(localStorage.getItem(coverageKey)||'null');
 if(rec?.tag!==JSON.stringify(totals))return null;
 const ids=[...ARTISTS.map(a=>a.id),'manual'],groups=rec.groups;
 if(!groups||Object.keys(groups).length!==ids.length||ids.some(id=>learnClasses.some(k=>!Number.isSafeInteger(groups[id]?.[k])||groups[id][k]<0)))return null;
 if(learnClasses.some(k=>ids.reduce((s,id)=>s+groups[id][k],0)!==(totals[k]?.n||0)))return null;
 return groups}catch(_){return null}
}
function statusApply(text){$('lblApplyStatus').textContent=text;linfo(text)}

let bakedBaseline=null, appliedTotals=null;
const learnClasses=['裏声','ミックス','地声'];
function ltally(rows){
 const totals={};
 for(const row of rows){if(learnStatus(row)!=='used')continue;
 const r=totals[row.kind]??{n:0,s:Array(7).fill(0)};r.n++;for(let i=0;i<7;i++)r.s[i]+=row.features[i];totals[row.kind]=r}
 return Object.fromEntries(Object.entries(totals).map(([k,{n,s}])=>[k,{n,m:s.map(x=>Math.round(1000*x/n)/1000)}]))
}
function lvalidate(t){
 if(!t||typeof t!=='object'||Array.isArray(t))return null;
 const keys=Object.keys(t);if(!keys.length||keys.some(k=>!learnClasses.includes(k)))return null;
 for(const v of Object.values(t))if(!v||!Number.isSafeInteger(v.n)||v.n<1||v.n>10000||!Array.isArray(v.m)||v.m.length!==7||v.m.some(x=>!Number.isFinite(x)||x< -9||x>5))return null;
 return t
}
function lmerged(base,t){
 if(!base)throw Error("初期声種モデルはこの独立試作に含まれていません。");
 const merge=(old,k)=>{const row=t?.[k];if(!row)return old.slice();const weight=Math.min(.55,row.n/(row.n+3));return old.map((x,i)=>(1-weight)*x+weight*row.m[i])};
 return {scales:base.scales.slice(),mix:merge(base.mix,'ミックス'),falsetto:merge(base.falsetto,'裏声'),chest:t?.['地声']?.n>=2?t['地声'].m.slice():null}
}
function lshowModel(){
 const count=Object.values(appliedTotals||{}).reduce((n,v)=>n+v.n,0);
 $('lblModelStatus').textContent=count?'追加基準を '+count+' 区間から適用中。':'独立試作：初期声種モデルは未移植です。音程解析・区間分析を利用できます。';
 $('lblResetModel').disabled=!count;$('lblHandoff').disabled=!count;showLearnCoverage();$('lblHandoffStatus').textContent=count?'前回反映した判定基準を書き出せます。区間を編集しても、反映し直すまでこの基準は変わりません。':'先に「区間を判定に反映」を押してください。'
}
function levaluateRange(start,end,buf=lready?.buffer){
if(!buf||end-start<.12)return null;
 const n=Math.min(72,Math.floor((end-start-.06)/.04)+1),w=new Float32Array(N),sum=Array(7).fill(0),ratio=buf.sampleRate/SR;
 const channels=Array.from({length:buf.numberOfChannels},(_,i)=>buf.getChannelData(i));let have=0;
 for(let frame=0;frame<n;frame++){const t=start+.03+(end-start-.06)*(n===1?.5:frame/(n-1)),j0=Math.round(t*buf.sampleRate-(N-1)*ratio/2);
 let best=0,chosen=null;for(const ch of channels){let e=0;for(let i=0;i<N;i+=4)e+=(ch[Math.floor(j0+i*ratio)]??0)**2;if(e>=best){best=e;chosen=ch}}
 for(let i=0;i<N;i++){const j=j0+i*ratio,k=Math.floor(j),x=chosen?.[k]??0;w[i]=x+(j-k)*((chosen?.[k+1]??0)-x)}
 const a=feat(w);if(!a.z||!a.z.every(Number.isFinite))continue;have++;for(let i=0;i<7;i++)sum[i]+=lclamp(a.z[i],-9,5)
 }
 return have>=3&&have/n>=.30?sum.map(x=>x/have):null
}
function lrefreshRecordFeatures(record){
 for(const r of lrows)if(r.key===record.key){if(record.role!=='判定基準用'||record.allowed!=='可'||!learnClasses.includes(r.kind)){r.features=null;r.featureKey=null;continue}if(!lready?.buffer){r.features=null;r.featureKey=null;continue}
 const basis=[r.kind,r.start,r.end].join('|');if(!r.features||r.featureKey!==basis){r.features=levaluateRange(r.start,r.end);r.featureKey=basis}}
}
$('lblApplyModel').onclick=()=>{
 if(!bakedBaseline){statusApply('初期声種モデルは独立試作に未移植です。区間分析・比較を利用してください。');return}const pending=new Set(lrows.filter(r=>r.role==='判定基準用'&&r.allowed==='可'&&learnClasses.includes(r.kind)&&!r.featureKey).map(r=>r.key));if(pending.size){statusApply('波形・判定基準を復元するため、未選択の基準用録音 '+pending.size+' 本を同じ元ファイルで選び直してください。');return}const totals=lvalidate(ltally(lrows));
 if(!totals||(!totals['裏声']&&!totals['ミックス']&&(totals['地声']?.n||0)<2)){statusApply('「利用可」の裏声・ミックス1区間以上、または地声2区間以上が必要です。0.12秒以上の明瞭な区間を選んでください。');return}
 appliedTotals=totals;saveCoverage(totals);baked=lmerged(bakedBaseline,totals);hist=[];let local=true;
 try{localStorage.setItem(lmodelKey,JSON.stringify(totals))}catch(_){local=false}
 lshowModel();statusApply(local?'反映完了。追加基準をこのSafariに保存し、メーターに適用しました。':'このタブでは適用しました。Safariの保存設定により、再読み込みすると元に戻ります。')
};
$('lblResetModel').onclick=()=>{
 if(!bakedBaseline||!appliedTotals)return;appliedTotals=null;appliedGroups=null;baked=bakedBaseline;hist=[];try{localStorage.removeItem(lmodelKey);localStorage.removeItem(coverageKey)}catch(_){}
 lshowModel();statusApply('初期サンプルの基準に戻しました。ラベルやCSVの内容は消していません。')
};


function zbMedian(a){if(!a.length)return null;const s=a.slice().sort((x,y)=>x-y);return (s[(s.length-1)>>1]+s[s.length>>1])/2}
function zbPercent(a,p){if(!a.length)return null;const s=a.slice().sort((x,y)=>x-y);return s[Math.min(s.length-1,Math.floor(p*(s.length-1)))]}
function zbPeriod(w,f){const lag=Math.round(16000/f);if(!(lag>0&&lag<w.length/2))return 0;let xy=0,xx=0,yy=0;for(let i=lag;i<w.length;i++){const x=w[i],y=w[i-lag];xy+=x*y;xx+=x*x;yy+=y*y}return xy/(Math.sqrt(xx*yy)||1)}
function zbLpc(w,order){
 const rate=8000,n=Math.floor((w.length-4)/2),x=new Float64Array(n),r=new Float64Array(order+1),c=new Float64Array(order+1);let prev=0;c[0]=1;
 for(let i=0;i<n;i++){const j=i*2;const u=(w[j]+4*w[j+1]+6*w[j+2]+4*w[j+3]+w[j+4])/16;x[i]=(u-.95*prev)*(.54-.46*Math.cos(2*Math.PI*i/(n-1)));prev=u}
 for(let k=0;k<=order;k++)for(let i=k;i<n;i++)r[k]+=x[i]*x[i-k];if(r[0]<1e-9)return null;
 let e=r[0]*1.0005;for(let m=1;m<=order;m++){let sum=r[m];for(let k=1;k<m;k++)sum+=c[k]*r[m-k];const a=-sum/e;if(Math.abs(a)>=.995)return null;const t=c.slice();for(let k=1;k<m;k++)c[k]=t[k]+a*t[m-k];c[m]=a;e*=1-a*a}
 const resp=[];for(let hz=150;hz<=3650;hz+=20){let a=0,b=0;for(let k=0;k<=order;k++){const p=2*Math.PI*hz*k/rate;a+=c[k]*Math.cos(p);b+=c[k]*Math.sin(p)}resp.push(-10*Math.log10(a*a+b*b||1e-12))}
 const peaks=[];for(let i=2;i<resp.length-2;i++){const x=resp[i];if(!(x>resp[i-1]&&x>=resp[i+1]))continue;let l=i,r=i;while(l>0&&resp[l]>x-3)l--;while(r<resp.length-1&&resp[r]>x-3)r++;if((r-l)*20>650||l===0||r===resp.length-1)continue;peaks.push(150+i*20)}
 return peaks.slice(0,3)
}
function zbFormants(w,f,period,backing){
 if(backing!=='なし'||f<100||f>330||period<.78)return null;
 const a=zbLpc(w,10),b=zbLpc(w,12);if(!a||!b||a.length!==3||b.length!==3||a.some((x,i)=>Math.abs(x-b[i])>(i?180:120)))return null;
 const v=a.map((x,i)=>(x+b[i])/2);if(v[0]<200||v[0]>1100||v[1]<700||v[1]>3100||v[2]<1400||v[2]>3650||v[1]-v[0]<200||v[2]-v[1]<220)return null;return v
}

let acousticRun=0;
const uiAcoustic=$('lblAcousticStatus'),acousticBody=$('lblAcousticBody');
const dbfs=x=>20*Math.log10(Math.max(.00001,x));
async function zbDecode(f){const raw=await labelRead(f);try{return await labelWebDecode(raw,16000)}catch(_){try{return await labelWebDecode(raw,44100)}catch(_){return labelPcmWav(raw)}}}
function zbRange(buf,r){
 const n=Math.max(3,Math.min(22,Math.floor((r.end-r.start)/.055))), w=new Float32Array(N),rate=buf.sampleRate,step=rate/SR;
 const channels=Array.from({length:buf.numberOfChannels},(_,i)=>buf.getChannelData(i));
 const rms=[],hz=[],period=[],harm=Array.from({length:7},()=>[]),form=Array.from({length:3},()=>[]);let peak=0;
 for(let frame=0;frame<n;frame++){
  const t=r.start+(r.end-r.start)*(frame+.5)/n;
  const start=Math.max(0,Math.round(Math.max(r.start,Math.min(r.end-.06,t-.03))*rate)),endSample=r.end*rate;let best=-1,ch=null;
  for(const c of channels){let e=0;for(let i=0;i<N;i+=8){const k=Math.floor(start+i*step);if(k<endSample)e+=(c[k]??0)**2}if(e>best){best=e;ch=c}}
  let energy=0;
  for(let i=0;i<N;i++){const ix=start+i*step,k=Math.floor(ix),a=k<endSample?(ch?.[k]??0):0,b=k+1<endSample?(ch?.[k+1]??a):0;const x=a+(ix-k)*(b-a);w[i]=x;energy+=x*x;peak=Math.max(peak,Math.abs(x))}
  rms.push(dbfs(Math.sqrt(energy/N)));
  if(r.end-r.start<.12)continue;const a=feat(w);if(!a.f)continue;
  const q=zbPeriod(w,a.f);hz.push(a.f);period.push(q);
  if(a.z&&q>.62)for(let i=0;i<7;i++)harm[i].push(a.z[i]*20/Math.LN10);
  const f=zbFormants(w,a.f,q,r.backing);if(f)for(let k=0;k<3;k++)form[k].push(f[k])
 }
 return {row:r,n,rms,hz,period,harm,form,peak:dbfs(peak)}
}
function zbStats(rows){const m=k=>rows.flatMap(a=>a[k]),med=k=>zbMedian(m(k));
 const round=(n,d=0)=>n===null?'—':n.toFixed(d);
 const f=Array.from({length:3},(_,i)=>round(zbMedian(rows.flatMap(a=>a.form[i]))));
 const h=Array.from({length:7},(_,i)=>round(zbMedian(rows.flatMap(a=>a.harm[i])),1));
 const frames=rows.reduce((n,r)=>n+r.n,0),pitch=m('hz'),vol=m('rms');
 return ['区間 '+rows.length+'／観測 '+frames+'窓、有声音程 '+pitch.length+'/'+frames,
         '波形音量 RMS 中央 '+round(med('rms'),1)+' dBFS、10〜90% '+round(zbPercent(vol,.1),1)+'〜'+round(zbPercent(vol,.9),1)+' dBFS、観測ピーク '+round(Math.max(...rows.map(a=>a.peak)),1)+' dBFS',
         '音程中央値 '+round(med('hz'))+' Hz、周期性中央値 '+round(med('period'),2),
         'H2〜H8（H1比・dB） '+h.join(' / '),
         'F1〜F3推定（Hz） '+f.join(' / ')+'、採用 '+rows.reduce((n,a)=>n+a.form[0].length,0)+'/'+frames+'窓（有声 '+pitch.length+'窓）']
}

const cvClasses=['地声','裏声','ミックス'], cvNone='保留・判定なし';
const cvId=r=>lRoleKey(r.singer);
function cvEqual(rows,features){
 const ids=new Map();for(const x of rows){const id=cvId(x.row),v=x[features];if(!v)continue;const list=ids.get(id)||[];list.push(v);ids.set(id,list)}
 const out=[...ids.values()].map(list=>list[0].map((_,i)=>zbMedian(list.map(v=>v[i]))));return out
}
function cvVector(s){
 const harmonics=s.harm[0].length>=3&&s.harm[0].length/s.n>=.30 ? s.harm.map(zbMedian):null;
 const formants=s.form[0].length>=3&&s.form[0].length/s.n>=.25?s.form.map(v=>Math.log(zbMedian(v))):null;
 return {row:s.row,harmonics,formants}
}
function cvFit(rows){
 const grouped=Object.fromEntries(cvClasses.map(k=>[k,rows.filter(s=>s.row.kind===k)]));
 const H=Object.fromEntries(cvClasses.map(k=>[k,cvEqual(grouped[k],'harmonics')]));
 if(cvClasses.some(k=>H[k].length<2))return null;
 const F=Object.fromEntries(cvClasses.map(k=>[k,cvEqual(grouped[k],'formants')]));
 const form=cvClasses.every(k=>F[k].length>=2);
 const all=Object.values(H).flat(), fc=form?Object.values(F).flat():[];
 const center=points=>points[0].map((_,i)=>zbMedian(points.map(x=>x[i])));
 const scale=(points,floor)=>center(points).map((c,i)=>Math.max(floor,1.4826*zbMedian(points.map(x=>Math.abs(x[i]-c)))));
 return {H:Object.fromEntries(cvClasses.map(k=>[k,center(H[k])])),hs:scale(all,5),
       F:form?Object.fromEntries(cvClasses.map(k=>[k,center(F[k])])):null,fs:form?scale(fc,.20):null};
}
function cvPredict(model,target,useFormants){
 const dist=(s,c,z)=>s.reduce((a,b,i)=>a+((b-c[i])/z[i])**2,0)/s.length;
 const h=target.harmonics;if(!h)return cvNone;
 const use=useFormants&&model.F&&target.formants;
 const scores=cvClasses.map(k=>{const d=dist(h,model.H[k],model.hs);
  return [k,use?(d+.25*dist(target.formants,model.F[k],model.fs))/1.25:d]}).sort((a,b)=>a[1]-b[1]);
 const x=scores[0][1],y=scores[1][1];return x<=4&&(y-x)/(y+x+1e-9)>=.20?scores[0][0]:cvNone
}
function cvBuild(samples){
 // Pair every evaluation row with a fit which has never seen that singer.
 const all=samples.map(cvVector).filter(x=>cvClasses.includes(x.row.kind)&&['判定基準用','テスト専用'].includes(x.row.role)&&x.row.allowed==='可');
 const cal=all.filter(x=>x.row.role==='判定基準用'),held=all.filter(x=>x.row.role==='テスト専用'),heldIDs=new Set(held.map(x=>cvId(x.row)));
 const result={scheme:held.length?'宣言済みテスト専用の歌い手':'歌い手丸ごとの交差検証',predictions:[],unsupported:[],total:0,trainers:0};
 const train=cal.filter(x=>!heldIDs.has(cvId(x.row)));result.trainers=new Set(train.map(x=>cvId(x.row))).size;
 const evalRows=held.length?held:cal;result.total=evalRows.length;
 for(const id of new Set(evalRows.map(x=>cvId(x.row)))){
  const fitted=cvFit(train.filter(x=>cvId(x.row)!==id)), cohort=evalRows.filter(x=>cvId(x.row)===id);
  if(!fitted){result.unsupported.push({id,n:cohort.length});continue}
  for(const x of cohort)result.predictions.push({id,truth:x.row.kind,a:cvPredict(fitted,x,false),b:cvPredict(fitted,x,true),form:!!(fitted.F&&x.formants&&x.harmonics)})
 }
 return result
}
function cvMetrics(rows,key){
 const by=new Map(),matrix=Object.fromEntries(cvClasses.map(k=>[k,Object.fromEntries([...cvClasses,cvNone].map(p=>[p,0]))]));
 for(const p of rows){matrix[p.truth][p[key]]++;const s=by.get(p.id)||[];s.push(p);by.set(p.id,s)}
 const avg=(x)=>x.length?x.reduce((a,b)=>a+b,0)/x.length:null;
 const per=[...by.entries()].map(([id,r])=>{
 const coverage=r.filter(x=>x[key]!==cvNone).length/r.length,correct=r.filter(x=>x[key]===x.truth).length/r.length;
 const f1=avg(cvClasses.filter(k=>r.some(x=>x.truth===k||x[key]===k)).map(k=>{const tp=r.filter(x=>x.truth===k&&x[key]===k).length;
  const tot=r.filter(x=>x.truth===k).length+r.filter(x=>x[key]===k).length;return tot?2*tp/tot:0}));
 return {id,n:r.length,coverage,correct,f1}
 });
 return {matrix,per,coverage:avg(per.map(x=>x.coverage)),correct:avg(per.map(x=>x.correct)),f1:avg(per.map(x=>x.f1))};
}
function cvPresent(samples,missing){
 const out=$('lblCompareBody'),p=cvBuild(samples),line=(t)=>out.append(zbNode('div',t));out.replaceChildren();
 const fmt=x=>x===null?'—':(100*x).toFixed(1)+'%';
 line('検証：'+p.scheme+'。判定基準用 '+p.trainers+'人。未読込の録音 '+missing+'本。');
 if(p.unsupported.length)line('比較に必要な別歌い手の学習データ不足：'+p.unsupported.map(r=>r.id+'（'+r.n+'区間）').join('、')+'。比較可能な学習側で各声種に2人以上必要です。');
 if(!p.predictions.length){line('比較できる組み合わせがありません。現在の判定は変更していません。');return}
 const used=p.predictions.filter(x=>x.form);
 const slices=[['すべての比較対象（フォルマントなしも含む）',p.predictions],['候補に信頼できるフォルマントを使用した区間',used]];
 line('評価できた区間 '+p.predictions.length+'/'+p.total+'、候補がフォルマントを使用できた区間 '+used.length+'/'+p.predictions.length+'。');
 for(const [label,slice] of slices){
 line(label+'：'+slice.length+'区間');
 for(const [key,name] of [['a','倍音のみ'],['b','倍音＋フォルマント候補']]){
 const s=cvMetrics(slice,key);line(name+'：歌い手均等F1 '+fmt(s.f1)+'、正しく判定 '+fmt(s.correct)+'、判定を出した割合 '+fmt(s.coverage));
 const e=document.createElement('details');e.append(zbNode('summary',name+'：歌い手別・声種別の内訳'));
 for(const x of s.per)e.append(zbNode('div',x.id+' '+x.n+'区間：F1 '+fmt(x.f1)+'、正しく判定 '+fmt(x.correct)+'、判定 '+fmt(x.coverage)));
 for(const k of cvClasses){const total=Object.values(s.matrix[k]).reduce((x,y)=>x+y,0);e.append(zbNode('div','正解 '+k+'（判定 '+fmt(total?1-s.matrix[k][cvNone]/total:null)+'） → '+[...cvClasses,cvNone].map(m=>m+' '+s.matrix[k][m]).join(' ／ ')))}
 out.append(e)
 }
 }
 const base=cvMetrics(p.predictions,'a'), ext=cvMetrics(p.predictions,'b');const enough=!missing&&!p.unsupported.length&&base.per.length>=2&&used.length>=6&&new Set(used.map(x=>x.id)).size>=2&&cvClasses.every(k=>used.some(x=>x.truth===k));
 if(!enough)line('採用判断は保留。信頼できるフォルマント・評価できる別歌い手・元録音のいずれかが不足しています。');
 else if(ext.f1>base.f1&&ext.coverage>=base.coverage)line('今回のデータでは候補を追加検証する価値があります。反映はしていません。');
 else line('今回のデータでは、倍音のみから切り替える根拠は得られませんでした。');
 line('判定なしも分母に含めています。性別は推定していません。異なる性別・歌い手集団への精度は未検証です。比較結果で現在の判定基準を自動変更しません。');
}

function zbNode(tag,text){const el=document.createElement(tag);el.textContent=text;return el}
function zbShow(track,rows){
 const card=document.createElement('article');card.append(zbNode('h4',track.name));
 for(const kind of ['地声','裏声','ミックス','保留']){
  const stats=rows.filter(x=>x.row.kind===kind);if(!stats.length)continue;
  const d=document.createElement('details');d.append(zbNode('summary',kind+' '+stats.length+'区間'));for(const line of zbStats(stats))d.append(zbNode('div',line));
  for(const t of stats){const a=document.createElement('details');a.append(zbNode('summary',lformat(t.row.start)+'〜'+lformat(t.row.end)));for(const line of zbStats([t]))a.append(zbNode('div',line));d.append(a)}card.append(d)
 }
 acousticBody.append(card)
}
$('lblCancelAcoustic').onclick=()=>{acousticRun++;$('lblAcoustic').disabled=false;$('lblAcousticApply').disabled=false;$('lblCancelAcoustic').hidden=true;$('lblCompare').disabled=false;uiAcoustic.textContent='分析を停止しました。ここまでの結果は残ります。'};
async function runAcoustic(apply=false,evaluate=false){
 const id=++acousticRun,snapshot=JSON.stringify(lproject()),ready=new Map(),tested=[];const tracks=new Map();const unavailable=new Set(),required=new Map();let unpermitted=0,used=0,bad=0;
 for(const row of lrows){if(row.allowed!=='可'){unpermitted++;continue}if(apply&&row.role==='判定基準用'&&learnClasses.includes(row.kind)&&!row.featureKey)required.set(row.key,row.name);if(!sessionAudio.has(row.key)){unavailable.add(row.key);continue}
 const t=tracks.get(row.key)||{name:row.name,rows:[],key:row.key};t.rows.push({...row});tracks.set(row.key,t)}
 acousticBody.replaceChildren();$('lblCompareBody').replaceChildren();$('lblAcoustic').disabled=true;$('lblAcousticApply').disabled=true;$('lblCompare').disabled=true;$('lblCancelAcoustic').hidden=false;
 const delay=()=>new Promise(r=>setTimeout(r,0));
 try{
 for(const track of tracks.values()){
  if(id!==acousticRun)return;uiAcoustic.textContent='端末内で分析中：'+track.name;await delay();
  let buf;try{buf=lf?.key===track.key&&lready?.buffer?lready.buffer:await zbDecode(sessionAudio.get(track.key))}catch(_){}
  if(id!==acousticRun)return;
  if(!buf){bad++;acousticBody.append(zbNode('div',track.name+'：波形をデコードできません。'));continue}
  const rows=[];for(const rr of track.rows){if(id!==acousticRun)return;rows.push(zbRange(buf,rr));used++;if(apply&&rr.role==='判定基準用'&&learnClasses.includes(rr.kind))ready.set(rr.id,{features:levaluateRange(rr.start,rr.end,buf),featureKey:[rr.kind,rr.start,rr.end].join('|')});if(rows.length%5===0)await delay()}
  required.delete(track.key);zbShow(track,rows);if(evaluate)tested.push(...rows)
 }
 if(id!==acousticRun)return;
 const summary='分析結果：'+used+'区間。元ファイルを選び直す必要がある録音 '+unavailable.size+'本、利用可でない区間 '+unpermitted+'件、解析できなかった録音 '+bad+'本。';
 uiAcoustic.textContent=summary+'元音声・分析結果は送信していません。';if(evaluate)cvPresent(tested,unavailable.size+bad);
 if(apply){
  if(JSON.stringify(lproject())!==snapshot){uiAcoustic.textContent=summary+'分析中に区間が変わったため、判定基準は変更していません。';return}
  if(required.size){uiAcoustic.textContent=summary+'未準備の判定基準用録音があるため、前の判定基準を変更していません。';for(const name of required.values())acousticBody.append(zbNode('div','要再選択：'+name));return}
  for(const r of lrows)if(ready.has(r.id))Object.assign(r,ready.get(r.id));
  showLearnCoverage();$('lblApplyModel').onclick();uiAcoustic.textContent=summary+' '+$('lblApplyStatus').textContent
 }
 }catch(_){if(id===acousticRun)uiAcoustic.textContent='分析中に問題が発生しました。表示済みの結果は残っています。'}
 finally{if(id===acousticRun){$('lblAcoustic').disabled=false;$('lblAcousticApply').disabled=false;$('lblCompare').disabled=false;$('lblCancelAcoustic').hidden=true}}
}
$('lblAcoustic').onclick=()=>runAcoustic(false);
$('lblAcousticApply').onclick=()=>runAcoustic(true);$('lblCompare').onclick=()=>runAcoustic(false,true);
function productionHandoff(base,totals){
 const checked=lvalidate(totals);
 if(!base||!checked||(!checked['裏声']&&!checked['ミックス']&&(checked['地声']?.n||0)<2))return null;
 const m=lmerged(base,checked), vectors=[m.scales,m.mix,m.falsetto,...(m.chest?[m.chest]:[])];
 if(vectors.some(a=>!Array.isArray(a)||a.length!==7||a.some(x=>!Number.isFinite(x)||x< -9||x>5))||m.scales.some(x=>!(x>0)))return null;
 const n=k=>checked[k]?.n||0, own=k=>1-Math.min(.55,n(k)/(n(k)+3));
 return {schema:'pitch-meter-voice-register-handoff',version:1,algorithm:'log-harmonic-centroid-v1',
  model:{scale:m.scales,mix:m.mix,falsetto:m.falsetto,chest_suppression:m.chest},
  coverage:{original_reference_count:6,added_interval_count:{mix:n('ミックス'),falsetto:n('裏声'),chest:n('地声')},
   original_weight:{mix:own('ミックス'),falsetto:own('裏声')}},
  source:'last-applied-calibration'};
}
$('lblHandoff').onclick=()=>{
 let data;try{data=productionHandoff(bakedBaseline,appliedTotals)}catch(_){}
 const status=$('lblHandoffStatus');
 if(!data){status.textContent='反映済みの判定基準がありません。先に「区間を判定に反映」を押してください。';return}
 const out=JSON.stringify(data,null,2);
 status.textContent='前回反映した判定基準を書き出します。音声やファイル名は入っていません。';
 lsaveBackup(new File([out+'\n'],'pitch-meter-production-model-v1.json',{type:'application/json'}))
};

function lbootModel(model){
 bakedBaseline=model;baked=model;
 try{appliedTotals=lvalidate(JSON.parse(localStorage.getItem(lmodelKey)||'null'));if(appliedTotals){baked=lmerged(bakedBaseline,appliedTotals);appliedGroups=loadCoverage(appliedTotals)}}catch(_){}
 lshowModel();try{if(!appliedTotals&&localStorage.getItem('pm_label_voice_model_v1'))$('lblModelStatus').textContent='旧版の追加基準は用途を確認できないため適用せず、初期サンプルを使っています。必要なら基準用区間を選び直してください。'}catch(_){}
}

$('linkGate').hidden=true;document.querySelector('main').hidden=false;lbootDraft();lshowModel();
if(location.pathname.startsWith('/labels'))labelMode(true,false);
</script><script>
// Frequencies remain unrounded. Only bounded, brief octave excursions are repaired.
const pitchMidi=f=>69+12*Math.log2(f/440);
const pitchNear=(a,b,tolerance=.75)=>a>0&&b>0&&Math.abs(pitchMidi(a)-pitchMidi(b))<=tolerance;
function repairReferencePitch(raw, gapSupported=()=>false) {
 const scoring=raw.slice();
 for(let i=3;i<raw.length;i++){
  const base=raw[i-1];if(!base||!raw[i]||![1,2,3].every(k=>pitchNear(raw[i-k],base)))continue;
  const jump=pitchMidi(raw[i])-pitchMidi(base),octave=Math.round(jump/12);
  if(Math.abs(octave)!==1||Math.abs(jump-12*octave)>.75)continue;
  let end=i;while(end<raw.length&&end-i<3&&pitchNear(raw[end],raw[i]))end++;
  if(end-i>2||end+2>=raw.length||![0,1,2].every(k=>pitchNear(raw[end+k],base)))continue;
  for(let j=i;j<end;j++)scoring[j]=raw[j]/Math.pow(2,octave);
  i=end-1;
 }
 const display=scoring.slice();
 for(let i=3;i<display.length;){
  if(display[i]){i++;continue}const start=i;while(i<display.length&&!display[i])i++;const end=i,base=display[start-1];
  if(end-start>2||end+2>=display.length||![1,2,3].every(k=>pitchNear(display[start-k],base))||![0,1,2].every(k=>pitchNear(display[end+k],base)))continue;
  if(!Array.from({length:end-start},(_,k)=>gapSupported(start+k,base)).every(Boolean))continue;
  for(let j=start;j<end;j++){const mix=(j-start+1)/(end-start+1);display[j]=Math.exp(Math.log(base)*(1-mix)+Math.log(display[end])*mix)}
 }
 return {scoring,display};
}
function supportsPitchContinuation(w,hz,rate=16000){
 const lag=Math.round(rate/hz);let xx=0,yy=0,xy=0,energy=0;
 for(let i=0;i<w.length;i++)energy+=w[i]*w[i];
 if(Math.sqrt(energy/w.length)<.004||lag<2||lag>=w.length/2)return false;
 for(let i=lag;i<w.length;i++){const a=w[i],b=w[i-lag];xx+=a*a;yy+=b*b;xy+=a*b}
 return xy/Math.sqrt(xx*yy||1)>.7;
}
// Causal microphone filter: ordinary motion is immediate; an octave jump needs
// three consecutive frames (80ms added at 25Hz). Confirmed onsets are backfilled.
class LivePitchFollower {
 constructor(){this.reset()}
 reset(){this.base=0;this.stable=0;this.pending=[];this.lastIndex=-1}
 finish(){const edits=this.pending.map(p=>({index:p.index,hz:p.raw}));this.pending=[];return edits}
 push(raw,index){
  const edits=[];if(index!==this.lastIndex+1){edits.push(...this.finish());this.base=0;this.stable=0}this.lastIndex=index;
  if(!(raw>0)){edits.push(...this.finish());this.base=0;this.stable=0;return {hz:0,edits}}
  if(this.pending.length){
   if(pitchNear(raw,this.base)){this.pending=[];this.stable++;this.base=raw;return {hz:raw,edits}}
   if(pitchNear(raw,this.pending[0].raw)){
    this.pending.push({index,raw});
    if(this.pending.length===3){edits.push(...this.finish());this.base=raw;this.stable=3;return {hz:raw,edits}}
    return {hz:raw/Math.pow(2,this.octave),edits};
   }
   edits.push(...this.finish());this.base=raw;this.stable=1;return {hz:raw,edits};
  }
  const jump=this.base?pitchMidi(raw)-pitchMidi(this.base):0,octave=Math.round(jump/12);
  if(this.stable>=3&&Math.abs(octave)===1&&Math.abs(jump-octave*12)<=.75){this.octave=octave;this.pending=[{index,raw}];return {hz:raw/Math.pow(2,octave),edits}}
  this.stable=pitchNear(raw,this.base)?this.stable+1:1;this.base=raw;return {hz:raw,edits};
 }

}

// Hold only the visible marker for a brief missed detection. Recorded bins remain unchanged.
class LivePitchPointer {
 constructor(holdSeconds=.18){this.holdSeconds=holdSeconds;this.reset()}
 reset(){this.hz=0;this.confirmedAt=-Infinity}
 observe(hz,audioTime){
  if(Number.isFinite(hz)&&hz>0&&Number.isFinite(audioTime)){this.hz=hz;this.confirmedAt=audioTime}
 }
 at(audioTime){
  const age=audioTime-this.confirmedAt;
  return age>=0&&age<=this.holdSeconds?this.hz:0;
 }
}

// Display-only note segmentation; never mutates or replaces scoring frequencies.
function buildPitchBars(frequencies, step=.04) {
 const midi=frequencies.map(f=>Number.isFinite(f)&&f>=90&&f<=800?69+12*Math.log2(f/440):null);
 const bars=[];
 for(let a=0;a<midi.length;){
  if(midi[a]===null){a++;continue}let b=a+1;while(b<midi.length&&midi[b]!==null)b++;
  const smooth=[];for(let i=a;i<b;i++){const near=midi.slice(Math.max(a,i-1),Math.min(b,i+2)).sort((x,y)=>x-y);smooth.push(near[Math.floor(near.length/2)])}
  let note=Math.round(smooth[0]),start=a,candidate=null,candidateStart=0;
  const emit=end=>{if(end-start>=3)bars.push({start:start*step,end:end*step,midi:note})};
  for(let i=a+1;i<b;i++){
   const value=smooth[i-a],target=Math.round(value);
   if(Math.abs(value-note)<=.75||target===note){candidate=null;continue}
   if(candidate!==target){candidate=target;candidateStart=i}
   if(i-candidateStart+1>=3){emit(candidateStart);start=candidateStart;note=target;candidate=null}
  }
  emit(b);a=b;
 }
 return bars;
}

// Display-only phrase pages. Absolute song timestamps remain the scoring clock.
function buildPhrasePages(reference,duration,step=.04){
 if(!(duration>0))return [];
 const rests=[];
 for(let i=0;i<reference.length;){
  if(reference[i]>0){i++;continue}
  const a=i;while(i<reference.length&&!(reference[i]>0))i++;
  const start=a*step,end=Math.min(duration,i*step);
  if(end-start>=.24-1e-8)rests.push({start,end});
 }
 const pages=[];let start=0;
 while(duration-start>8+1e-8){
  const min=start+3,max=start+8,target=start+6;
  const cuts=rests.filter(r=>r.end>min&&r.start<max).map(r=>Math.max(min,Math.min(max,Math.max(r.start,Math.min(r.end,(r.start+r.end)/2)))));
  const end=cuts.length?cuts.sort((a,b)=>Math.abs(a-target)-Math.abs(b-target))[0]:max;
  pages.push({start,end});start=end;
 }
 pages.push({start,end:duration});return pages;
}
function phrasePageAt(pages,time){
 if(!pages.length)return -1;
 let lo=0,hi=pages.length-1;
 while(lo<hi){const mid=Math.floor((lo+hi)/2);if(time>=pages[mid].end)lo=mid+1;else hi=mid}
 return lo;
}
function phrasePageView(pages,time,width){
 const index=phrasePageAt(pages,time),page=pages[index]||{start:0,end:1};
 const left=8,right=Math.max(left+1,width-8),scale=(right-left)/Math.max(.001,page.end-page.start);
 const x=t=>left+(t-page.start)*scale;
 return {index,page,left,right,scale,x,head:Math.max(left,Math.min(right,x(time)))};
}
function drawPhraseGuide(g,bars,view,y,verdicts){
 for(let i=0;i<bars.length;i++){
  const bar=bars[i],start=Math.max(bar.start,view.page.start),end=Math.min(bar.end,view.page.end);
  if(end<=start)continue;
  const x1=view.x(start),x2=view.x(end),center=y(440*2**((bar.midi-69)/12));
  let top=center-4,bottom=center+4;
  const verdict=verdicts?.get(i);
  if(verdict&&!verdict.success&&verdict.shift){
   // Keep the red bar's original 8px width and measured position. Cut back only
   // the edge of this guide that would otherwise collide with the red bar.
   const shifted=y(440*2**((bar.midi+verdict.shift-69)/12));
   const gap=Math.min(1,Math.abs(shifted-center)*.25);
   if(shifted<center)top=Math.max(top,shifted+4+gap);
   else bottom=Math.min(bottom,shifted-4-gap);
  }
  if(bottom<=top)continue;
  // Only the unpassed guide is translucent, never the meter or judged result.
  if(x2<=view.head)g.fillStyle='#dfb1ff';
  else if(x1>=view.head)g.fillStyle='rgba(223,177,255,.55)';
  else {const fade=g.createLinearGradient(x1,0,x2,0),cut=(view.head-x1)/(x2-x1);fade.addColorStop(0,'#dfb1ff');fade.addColorStop(cut,'#dfb1ff');fade.addColorStop(cut,'rgba(223,177,255,.55)');fade.addColorStop(1,'rgba(223,177,255,.55)');g.fillStyle=fade;}
  g.beginPath();g.roundRect(x1,top,x2-x1,bottom-top,Math.min((bottom-top)/2,(x2-x1)/2));g.fill();
 }
}
function drawPhraseTrace(g,data,view,y,through,step=.04){
 g.strokeStyle='#ff99ce';g.lineWidth=2;g.lineCap='round';g.lineJoin='round';g.beginPath();
 const from=Math.max(0,Math.floor(view.page.start/step)),to=Math.min(data.length-1,Math.floor(Math.min(through,view.page.end)/step));
 let pen=false;
 for(let i=from;i<=to;i++){
  const f=data[i],time=i*step;
  if(!(f>0)){pen=false;continue}
  // Never carry a segment from the previous page or draw future singing.
  if(time<view.page.start)continue;
  const x=Math.min(view.right,view.x(time));
  if(pen)g.lineTo(x,y(f));else {g.moveTo(x,y(f));g.lineTo(x,y(f));}pen=true;
 }
 g.stroke();
}
function phraseAccuracy(reference,actual,page,through,step=.04){
 let expected=0,voiced=0,matched=0;
 const first=Math.max(0,Math.ceil(page.start/step)),last=Math.min(reference.length-1,Math.floor(Math.min(through,page.end)/step));
 for(let i=first;i<=last;i++){
  const r=reference[i];if(!(r>0)||i*step>=page.end)continue;expected++;
  const f=actual[i];if(!(f>0))continue;voiced++;
  if(Math.abs(1200*Math.log2(f/r))<200-1e-7)matched++;
 }
 return {expected,voiced,matched,accuracy:expected?matched/expected:0,eligible:expected>=10&&voiced>=10&&matched/expected>=.7};
}
function createPhraseCelebration(){
 const checked=new Set();let flash=null;
 return {reset(){checked.clear();flash=null},update(view,time,reference,actual,step=.04){
  if((time-view.page.start)/(view.page.end-view.page.start)>=.7&&!checked.has(view.index)){
   checked.add(view.index);if(phraseAccuracy(reference,actual,view.page,time,step).eligible)flash={page:view.index,start:time};
  }
  return flash&&flash.page===view.index&&time>=flash.start&&time-flash.start<.85?time-flash.start:null;
 }};
}
function drawPhraseSparkles(g,width,height,age){
 if(age===null)return;
 const progress=age/.85;g.save();g.globalAlpha=.28*Math.sin(Math.PI*progress);g.strokeStyle='#ffd9f1';g.lineWidth=1.4;
 for(let i=0;i<10;i++){
  const x=((i/10+progress*.65)%1)*width,y=height*(.2+.6*((i*7%11)/10)),r=2+i%3;
  g.beginPath();g.moveTo(x-r,y);g.lineTo(x+r,y);g.moveTo(x,y-r);g.lineTo(x,y+r);g.stroke();
 }
 g.restore();
}

// One display verdict per original guide bar, independent of page clipping/scoring.
function judgeGuideBar(bar,reference,actual,step=.04){
 const duration=Math.max(0,bar.end-bar.start),deviations=[];let matched=0,voiced=0;
 for(let i=Math.max(0,Math.floor(bar.start/step));i*step<bar.end;i++){
  const weight=Math.max(0,Math.min(bar.end,(i+1)*step)-Math.max(bar.start,i*step));
  const r=reference[i],f=actual[i];if(!(r>0&&f>0&&Number.isFinite(r)&&Number.isFinite(f)))continue;
  const cents=1200*Math.log2(f/r);voiced+=weight;deviations.push({cents,weight});
  if(Math.abs(cents)<200-1e-7)matched+=weight;
 }
 const ratio=duration?matched/duration:0,success=ratio>=.5-1e-9;
 let shift=0;
 if(!success&&voiced>=Math.min(.12,duration*.5)&&deviations.length){
  deviations.sort((a,b)=>a.cents-b.cents);let sum=0,median=0;
  for(const d of deviations){sum+=d.weight;if(sum>=voiced/2){median=d.cents;break}}
  const direction=Math.sign(median),support=deviations.reduce((s,d)=>s+(Math.sign(d.cents)===direction?d.weight:0),0);
  if(Math.abs(median)>=50&&support/voiced>=.6)shift=direction*Math.min(4,Math.max(1,Math.abs(median)/100));
 }
 return {success,ratio,shift};
}
function finalizeGuideBars(results,bars,reference,actual,through,step=.04){
 for(let i=0;i<bars.length;i++)if(!results.has(i)&&bars[i].end<=through+1e-8)results.set(i,judgeGuideBar(bars[i],reference,actual,step));
}
function drawGuideVerdicts(g,bars,results,view,y,height=8){
 for(let i=0;i<bars.length;i++){
  const result=results.get(i);if(!result)continue;const bar=bars[i];
  const start=Math.max(view.page.start,bar.start),end=Math.min(view.page.end,bar.end);if(end<=start)continue;
  const x=view.x(start),w=view.x(end)-x;
  // Unvoiced or directionally ambiguous: leave the original guide neutral.
  if(!result.success&&!result.shift)continue;
  const excellent=result.success&&result.ratio>=.7-1e-9;
  if(excellent){const gradient=g.createLinearGradient(x,0,x+w,0);gradient.addColorStop(0,'#bb7ce8');gradient.addColorStop(1,'#f285be');g.fillStyle=gradient;}else g.fillStyle=result.success?'#ff99ce':'#ff667d';g.shadowColor='rgba(255,153,206,.25)';g.shadowBlur=result.success?3:0;
  g.beginPath();g.roundRect(x,y(440*2**((bar.midi+result.shift-69)/12))-height/2,w,height,Math.min(height/2,w/2));g.fill();
  if(excellent&&w>3){g.shadowBlur=0;g.fillStyle='rgba(255,255,255,.18)';g.beginPath();g.roundRect(x+1,y(440*2**((bar.midi-69)/12))-height/2+1,w-2,Math.min(2,height/3),1);g.fill();}
 }
 g.shadowBlur=0;
}

// Karaoke is entirely browser-local. No fetch, upload, or persistent recording.
function scoreTake(reference, actual, step=.04) {
 const expected=reference.reduce((n,f)=>n+(f>0),0);
 if(expected<25)return {valid:false,reason:'見本の有声音が1秒未満のため採点できません。'};
 let best={loss:Infinity,strict:Infinity,shift:0,coverage:0};
 for(let shift=-Math.round(1.5/step);shift<=Math.round(1.5/step);shift++){
  let loss=0,strict=0,covered=0;
  reference.forEach((f,i)=>{if(!f)return;const a=actual[i+shift]||0;if(!a){loss+=100;strict+=2400;return}covered++;const cents=Math.abs(1200*Math.log2(a/f));strict+=Math.min(2400,cents);loss+=cents<=200+1e-7?0:Math.min(100,(cents-200)/3)});
  loss/=expected;
  if(loss<best.loss-1e-8||(Math.abs(loss-best.loss)<1e-8&&(strict<best.strict-1e-7||(Math.abs(strict-best.strict)<1e-7&&Math.abs(shift)<Math.abs(best.shift)))))best={loss,strict,shift,coverage:covered/expected};
 }
 let streak=0,longest=0;
 reference.forEach((f,i)=>{streak=f>0&&(actual[i+best.shift]||0)>0?streak+1:0;longest=Math.max(longest,streak)});
 return {valid:true,score:Math.round(Math.max(0,Math.min(100-best.loss,100*best.coverage))),delay:best.shift*step,coverage:best.coverage,bonusEligible:best.coverage*expected>=Math.max(25,.2*expected)&&longest>=10};
}
// One closure per take: no second random draw on repeated score-button presses.
function createTakeScorer(random=Math.random){
 let cached=null;
 return (reference,actual)=>{
  if(cached)return cached;
  const base=scoreTake(reference,actual);if(!base.valid)return cached=base;
  const bonus=base.bonusEligible?22+Math.min(5,Math.floor(random()*6)):0;
  return cached={...base,baseScore:base.score,bonus,score:Math.min(100,base.score+bonus)};
 };
}
// Choose the true best candidate first, then reject any pitch that the unchanged mic cannot score.
function karaokeMicCompatible(track){return track.map(f=>f>90&&f<800?f:0)}
function plotPitchTrace(g,data,{now,step,head,scale,width,y,color,weight,history=false,spanEdges=false}){
 const x=i=>head+(i*step-now)*scale,endX=history?head:width;
 const a=Math.max(0,Math.floor((now-head/scale)/step)-1),b=Math.min(data.length,Math.ceil((now+(endX-head)/scale)/step)+1);
 const valid=f=>Number.isFinite(f)&&f>0;
 g.strokeStyle=color;g.lineWidth=weight;g.lineCap='round';g.lineJoin='round';g.beginPath();
 let pen=false;
 for(let i=a;i<b;i++){
  const f=data[i],px=x(i);
  if(!valid(f)||px>endX){pen=false;continue}
  const yy=y(f),half=spanEdges?step*scale*.5:0;
  if(!pen){g.moveTo(px-half,yy);if(half)g.lineTo(px,yy)}
  else g.lineTo(px,yy);
  if(half&&!valid(data[i+1]))g.lineTo(Math.min(endX,px+half),yy);
  pen=true;
 }
 g.stroke();
}
// Match the available original meter's fixed MIDI 52..74 position mapping.
// Original app's red interpolation source is unavailable; preserve the documented
// white-red-white behavior, holding red from mix to halfway toward falsetto.
function karaokePointerColor(hz){
 const p=Math.max(0,Math.min(1,(69+12*Math.log2(hz/440)-52)/22));
 const smooth=t=>{t=Math.max(0,Math.min(1,t));return t*t*(3-2*t)};
 const red=smooth((p-1/3)/(1/6))*(1-smooth((p-2/3)/(1/6)));
 return 'rgb(255,'+Math.round(241+(83-241)*red)+','+Math.round(250+(106-250)*red)+')';
}
function karaokeMeterGeometry(height,lo,hi){
 const pad=Math.max(11,Math.min(24,Math.round(height*.09)));
