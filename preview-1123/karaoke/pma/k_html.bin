<!doctype html><html lang="ja"><meta charset="utf-8"><meta name="robots" content="noindex,nofollow,noarchive"><meta name="referrer" content="no-referrer"><style>[hidden]{display:none!important}</style><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src blob:; style-src 'unsafe-inline'; connect-src blob: data:; media-src blob:; img-src blob: data:; base-uri 'none'; form-action 'none'"><script>/* 単一HTML版：カラオケ v17 の Worker を、このファイルの中のデータから作る（外部通信なし）。v17 の処理そのものは変えない。 */
(function () {
'use strict';
const P = window.parent && window.parent.PMA, Real = window.Worker;
const MAP = { '/separator-worker.js': ['w_sep', true], '/reference-pitch-worker.js': ['w_ref', false] };
window.Worker = function (url, opts) {
  const m = MAP[String(url).split('?')[0]]; if (!m || !P) throw new Error('同梱されていないWorkerです: ' + url);
  const w = new Real(URL.createObjectURL(new Blob([P.textSync(m[0])], { type: 'text/javascript' })), opts);
  if (m[1]) {
    const orig = w.postMessage.bind(w);
    let q = P.karaokeAssets().then((a) => orig({ __pmAssets: a.data }, a.transfer))
      .catch((e) => { w.dispatchEvent(new ErrorEvent('error', { message: String(e && e.message || e) })); throw e; });
    w.postMessage = (msg, tr) => { q = q.then(() => orig(msg, tr), () => {}); };
  }
  return w;
};
window.Worker.prototype = Real.prototype;
})();
</script><script>/* 単一HTML版：再生音の 歌声／伴奏 の音量だけを変える（見本バー・採点・声区判定には一切影響しない）。
   伴奏 = 元の音 − 分離した歌声。出力 = 元の音×伴奏 ＋ 歌声×(歌声−伴奏) ＝ 歌声×歌声音量 ＋ 伴奏×伴奏音量。
   伴奏のコピーを作らないので、長い曲でもメモリは「歌声（モノラル）1本分」しか増えない。両方100%なら元の音とまったく同じ。 */
window.__pmMix = {
  vol: { v: 1, a: 1 }, stems: null, go: null, gx: null, acc: null,
  lv(k) { const s = !!this.stems, v = this.vol.v, a = this.vol.a; return k === 'o' ? (s ? a : v) : (s ? v - a : 0); },
  gain(ac, k) { const n = 'g' + k;
    if (!this[n] || this[n].context !== ac) { this[n] = ac.createGain(); this[n].connect(ac.destination); }
    this[n].gain.value = this.lv(k); return this[n]; },
  startAcc(ac, t, o) { this.stopAcc(); if (!this.stems) return; const s = ac.createBufferSource(); s.buffer = this.stems.voc; s.connect(this.gain(ac, 'x')); s.start(t, o || 0); this.acc = s; },
  stopAcc() { if (this.acc) { try { this.acc.stop(); } catch (e) {} this.acc.disconnect(); this.acc = null; } },
  set(k, x) { this.vol[k] = x; for (const q of ['o', 'x']) { const g = this['g' + q]; if (g) g.gain.setTargetAtTime(this.lv(q), g.context.currentTime, 0.02); } },
  setStems(decoded, voc) {
    this.stems = null; if (!decoded || !voc || voc.length !== decoded.length) return;
    const vb = new AudioBuffer({ length: decoded.length, numberOfChannels: 1, sampleRate: decoded.sampleRate });
    vb.copyToChannel(voc, 0); this.stems = { voc: vb };
  }
};
window.__pmSeg = { pos: 0, from: 0, to: null, gate: 0, keep: false, key: '' }; // 再生位置・採点区間（区間採点用）
</script><style>html.pmb,html.pmb body{background:#111118!important;overflow:hidden}
html.pmb main{max-width:none!important;padding:0!important;margin:0!important}
html.pmb main>*:not(#karaokePage){display:none!important}
html.pmb #karaokePage>*:not(.kStage){display:none!important}
html.pmb .kStage{background:#24212c!important;border-radius:22px;box-shadow:none!important}
html.pmb .kStage{aspect-ratio:auto!important;height:100vh!important}
#pmScore{position:absolute;top:7%;bottom:7%;right:2.2%;width:36%;z-index:5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2%;background:linear-gradient(160deg,#24212c,#1c1a24);border:1px solid #f285be80;border-radius:22px;box-shadow:0 0 0 1px #ffffff14 inset,0 8px 30px #f285be40;cursor:pointer;font-family:system-ui;line-height:1;overflow:hidden;animation:pmIn .45s cubic-bezier(.2,1.4,.4,1)}
#pmScore:before{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,#ffffff22 50%,transparent 70%);transform:translateX(-120%);pointer-events:none}
#pmScore.done:before{animation:pmShine 1s ease-out .05s}
#pmScore .lbl{font-size:clamp(10px,7vh,18px);font-weight:700;letter-spacing:.42em;color:#f285be}
#pmScore .num{display:flex;align-items:baseline;gap:.1em}
#pmScore .n{font-size:clamp(36px,36vh,112px);font-weight:800;letter-spacing:.01em;font-variant-numeric:tabular-nums;background:linear-gradient(90deg,#bb7ce8,#f285be);-webkit-background-clip:text;background-clip:text;color:transparent}
#pmScore.done .n{animation:pmPop .5s ease-out}
#pmScore .u{font-size:clamp(14px,11vh,34px);font-weight:700;color:#f7d6e8}
#pmScore .bar{width:78%;height:clamp(5px,3.2vh,10px);border-radius:999px;background:#ffffff14;overflow:hidden}
#pmScore .bar i{display:block;height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,#3bc4e0,#a678ff 50%,#f285be)}
#pmScore.done{box-shadow:0 0 0 1px #ffffff14 inset,0 0 34px #f285be80}
#pmScore.msg{font-size:15px;color:#f7d6e8;padding:14px 18px;text-align:center}
@keyframes pmIn{from{opacity:0;transform:scale(.85)}to{opacity:1;transform:scale(1)}}
@keyframes pmPop{0%{transform:scale(1)}40%{transform:scale(1.12)}100%{transform:scale(1)}}
@keyframes pmShine{to{transform:translateX(120%)}}
</style><title>Pitch Meter | カラオケ試作</title><style>
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top left,#683249 0%,transparent 61%),#0d0e11;color:#ececef;font:16px system-ui}main{max-width:520px;margin:auto;padding:20px 16px}.brand{font-size:12px;font-weight:700;letter-spacing:.20em;color:#f285be}h1{font-size:28px;margin:8px 0 18px}section{background:#17171c;border:1px solid #48434e;border-radius:18px;padding:16px;margin:12px 0}button{font:600 14px system-ui;min-height:44px;margin:6px 6px 6px 0;padding:10px 16px;color:#221628;border:1px solid #a16f90;border-radius:10px;background:linear-gradient(90deg,#bb7ce8,#f285be)}button:disabled{opacity:.35}small{display:block;color:#b4b1b9;line-height:1.5}.meter{height:106px;position:relative}.rail{position:absolute;top:55px;left:0;right:0;height:11px;background:linear-gradient(90deg,#3bc4e0,#a678ff,#ff8c6b);border-radius:999px}.dot{position:absolute;top:53px;left:50%;width:15px;height:15px;transform:translateX(-50%);border-radius:50%;background:#fff;border:1px solid #fff4f1;box-shadow:0 0 15px #e34f70}.dot::before{content:'';position:absolute;left:6px;top:-5px;height:23px;width:2px;background:white}.pointer{position:absolute;top:20px;left:50%;width:158px;transform:translateX(-50%);display:flex;gap:6px;justify-content:center;white-space:nowrap;font:600 13px system-ui;align-items:baseline}.pointer #pitch{font-variant-numeric:tabular-nums;min-width:7.8em}.pointer #label{flex:none;width:4.5em;opacity:0;transition:opacity 170ms ease;color:#f7b1d3}.pointer #label.show{opacity:1}.tick{position:absolute;top:72px;width:1px;height:5px;background:#ffffff69}.endpoints{position:absolute;left:0;right:0;top:81px;display:flex;justify-content:space-between;color:#b4b1b9;font-size:11px}#msg{display:block;color:#b4b1b9;margin-top:6px;font-size:13px}#dot{opacity:0;transition:opacity 120ms}#dot.on{opacity:1}@media(prefers-reduced-motion:reduce){.pointer #label,#dot{transition:none}}
.fixed{position:absolute;top:35px;left:0;right:0;display:flex;justify-content:space-around;font-size:11px;font-weight:700;color:#ececef;opacity:1;transition:opacity 0s linear 170ms}.meter.confident .fixed{opacity:0;transition:none}.pointer{top:10px}meter{display:block;width:100%;height:9px;accent-color:#f285be;margin-top:10px}main{padding:16px;max-width:520px}h1{font-size:32px;line-height:1.48;color:#f285be;background:linear-gradient(90deg,#bb7ce8,#f285be);background-clip:text;-webkit-text-fill-color:transparent;margin:24px 0}.brand{font-size:10px;letter-spacing:3px}.editor{border:0;border-radius:24px;display:grid;gap:12px;margin:18px 0}.stage{position:relative;height:220px;overflow:hidden;border-radius:14px;background:#000;container-type:inline-size}.stage.tall{height:420px}#media{position:absolute;width:100%;height:100%;inset:0;object-fit:contain}.meter{position:absolute;left:5%;right:5%;bottom:5.5%;height:22.05cqw;background:rgba(14,13,18,.78);border-radius:2.25cqw;pointer-events:none;overflow:visible}.rail{top:50.2%;height:2.52cqw}.dot{top:56%;width:3.42cqw;height:3.42cqw;transform:translate(-50%,-50%);box-shadow:0 0 11px #e34f70}.dot::before{left:50%;top:-45%;width:1px;height:190%}.pointer{top:3%;font-size:clamp(11px,2.88cqw,14px)}.fixed{top:26%;font-size:2.34cqw}.tick{top:66%;height:4px}.endpoints{top:73%;font-size:2.1cqw}.disclaimer{position:absolute;bottom:7%;left:6%;right:6%;text-align:center;font-size:1.72cqw}.select{display:block;position:relative;background:linear-gradient(90deg,#bb7ce8,#f285be);color:#221628;padding:12px;border-radius:10px;text-align:center;min-height:49px;font-size:18px;font-weight:600}.select input{position:absolute;inset:0;width:100%;height:100%;opacity:0}.playrow{display:flex;align-items:center;gap:5px}#pos{margin-left:auto}#filename{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#seek{width:100%;accent-color:#f285be}.playrow button,#stop{background:#25232a;color:#ececef}
#labelsPage{margin-top:9px;border:0;padding:14px}#labelsPage h2{margin:8px 0}#labelsPage .select{margin:12px 0;background:#292632;color:#fbe6f1}#labelsPage small{margin:6px 0}#labelsFileName{overflow-wrap:anywhere;font-size:13px}
#labelsPage label{display:block}#labelsPage input:not([type=file]),#labelsPage select{padding:7px 6px;color:#fff;font:16px system-ui;background:#24212a;border:1px solid #595361;border-radius:7px;min-width:0;width:100%}
.tagFields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin:12px 0}.tagFields label,.labelNote,.waveHead{font-size:12px}
#lblTimeline{position:relative;height:154px;margin:5px 14px;touch-action:pan-y;border:1px solid #4b4558;background:#101016;border-radius:8px}
#lblWave{width:100%;height:100%;display:block;border-radius:8px}
#labelsPage .lblHandle{touch-action:none;position:absolute;top:0;transform:translateX(-50%);width:40px;padding:3px;margin:0;background:#f6c7dd;color:#241724;max-height:42px;min-height:42px;font-size:11px;border:1px solid #b66d9d}
#labelsPage #lblEndHandle{top:auto;bottom:0;background:#c8b6f6}.waveHead{display:flex;justify-content:space-between;align-items:center;gap:8px;color:#cfc8d5}.waveHead label{display:flex!important;gap:6px;align-items:center;white-space:nowrap}
#lblRows{padding:0;list-style:none}#lblRows li{border-left:4px solid var(--tag);background:#211f29;border-radius:7px;margin:6px 0;padding:8px 10px;overflow-wrap:anywhere}#lblRows li strong{color:var(--tag)}#lblRows li button{margin-bottom:0}.labelsMode{max-width:940px}
#labelsInfo{min-height:1.5em}

#labelsPage #lblTimeline,#labelsPage #lblScrub{touch-action:none;-webkit-touch-callout:none;user-select:none} #lblTimeline.headHeld{outline:2px solid #f6df89}#lblScrub.headHeld #lblScrubHead{width:9px}
#labelsPage .lblScrollBar{display:flex!important;align-items:center;gap:9px;font-size:12px;margin:3px 14px;color:#cfc8d5;white-space:nowrap}#labelsPage #lblScroll{height:30px;accent-color:#c8b6f6;padding:0;margin:0;touch-action:pan-y}#labelsPage #lblScroll:disabled{opacity:.42}
#lblScrub{position:relative;min-height:44px;touch-action:pan-y;cursor:pointer;margin:3px 14px 0;outline-offset:2px}
#lblScrub::before{content:"";position:absolute;left:0;right:0;top:15px;height:12px;background:#4c4658;border-radius:6px}
#lblScrubHead{position:absolute;top:12px;width:5px;height:19px;background:#f6df89;border-radius:3px;transform:translateX(-50%);pointer-events:none}
#lblScrubMarks{display:flex;justify-content:space-between;margin:0 14px 7px;font:10px system-ui;color:#c0bacb;pointer-events:none}.cursorLine{color:#f6df89}

#artistCards{display:grid;grid-template-columns:minmax(0,1fr);gap:16px;margin:18px 0}
.artistCard{padding:16px;border:1px solid #565061;border-radius:20px;background:#1a1821;text-align:left;min-width:0}
.artistCard h3{font-size:20px;margin:0 0 4px}.artistVoice{font-size:15px;color:#ffcbe5}.artistCard.artistActive{border-color:#c680b0}.artistCard .artistTracks{list-style:none;padding:0;margin:0}.artistTracks button{text-align:left;max-width:100%;overflow-wrap:anywhere;background:#292632;color:#f4e7ef;border-color:#595061}
#artistEditor{border-top:1px solid #4e4253;margin-top:7px}#manualArtist{border-top:1px solid #4e4253;padding:8px 0}.artistCard .tagFields{grid-template-columns:repeat(auto-fit,minmax(110px,1fr))}
#artistCards[hidden],#artistDetail[hidden],#manualArtist[hidden]{display:none!important}.artistCard .artistOpen{display:block;width:100%;min-height:100px;text-align:left;margin:0;padding:14px;color:#ececef;background:#201c28;border-color:#605469}.artistOpen strong,.artistOpen span,.artistOpen small{display:block}.artistOpen strong{font-size:20px}.artistOpen .artistVoice{margin:3px 0}.artistCard{padding:0;overflow:hidden}.artistCard .artistTracks{margin:0 14px}.artistCard .artistTracks:empty{display:none}
#artistDetail button:first-child{min-height:44px}#artistDetailTitle{margin:10px 0}.artistDetailTracks{list-style:none;padding:0}.artistDetailTracks button{background:#292632;color:#f4e7ef;margin:3px;overflow-wrap:anywhere;max-width:100%}#manualArtist #openManualEditor{background:#292632;color:#eee;font-size:12px}
#labelsPage .lblHandle,#labelsPage #lblEndHandle{top:auto;bottom:-15px;min-height:36px;height:36px;border-radius:4px}#labelsPage #lblTimeline{margin-bottom:20px}
#lblKinds{margin:12px 0 4px;padding:2px 0;border:0}#lblKinds legend{font-weight:700}#lblKinds div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}#lblKinds button{padding:3px;margin:0;font-size:12px;background:#292632;color:#f4e7ef;border-color:#595361}#lblKinds button[aria-pressed=true]{background:#f4c5df;color:#271925;border-color:#ffc5df}#lblCommitStatus{color:#b8ebbe;margin-left:6px;font-weight:700}#artistProject summary{cursor:pointer;color:#d8c9db;font-size:13px}
html.labelsScrolling{overscroll-behavior-y:contain;overscroll-behavior-x:none}
main.labelsMode{padding-left:max(18px,calc(env(safe-area-inset-left,0px) + 12px));padding-right:max(18px,calc(env(safe-area-inset-right,0px) + 12px))}
#labelsPage #lblTimeline,#labelsPage #lblScrub,#labelsPage .lblScrollBar{margin-left:max(23px,env(safe-area-inset-left,0px));margin-right:max(23px,env(safe-area-inset-right,0px))}
#labelsPage #lblTimeline,#labelsPage #lblScrub,#labelsPage .lblHandle,#labelsPage #lblScroll{overscroll-behavior:none;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
.artistDetailHead{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.artistDetailHead h3{min-width:0;overflow-wrap:anywhere}#artistBack{background:#302635;color:#fff;line-height:1;min-width:44px;min-height:44px;font-size:26px;padding:5px 12px;margin:4px 0 0;flex:none}
.wavePlayback{display:flex;align-items:center;margin:-4px 23px 0}.wavePlayback #lblListen{margin:2px 0 4px;min-width:88px}
</style><style>
.modeNav{display:flex;gap:8px;margin-bottom:24px}.modeNav button{flex:1}.modeNav button[aria-pressed=false]{background:#211c29;color:#ddd}#karaokePage .brand{font-size:13px}.kIntro{color:#d1b9d4}.kStage{position:relative;background:radial-gradient(ellipse at 30% 65%,#39203940,#11101540 75%);border-radius:20px;overflow:hidden;width:100%;aspect-ratio:27/8;box-shadow:inset 0 0 0 1px #5b3b5d33}#kCanvas{position:absolute;inset:0;width:100%;height:100%;display:block}#kCount{position:absolute;inset:0;display:grid;place-items:center;font-size:clamp(26px,10vw,48px);color:#ffe7f6;pointer-events:none}.kLegend{display:flex;gap:15px;flex-wrap:wrap;font-size:14px;margin:12px 0;color:#bd88ed}.kLegend strong{color:#ff91c7}#kTime{margin-left:auto;color:#d4c5d4}#kSource{display:block;width:100%;padding:12px;margin:8px 0 16px;font:16px system-ui;background:#211c29;color:#f6e5f3;border:1px solid #82618a;border-radius:10px}#karaokePage a{color:#e5b4ff}.kControls{display:flex}.kControls button{flex:1}#kStatus{font-size:14px;min-height:42px;color:#ddcbdc}#karaokePage small{margin:10px 0;font-size:13px}#karaokePage details{margin:20px 0;line-height:1.7;color:#c9bacb;font-size:14px}#kResult strong{font-size:40px;color:#efb1e3}main{padding-bottom:40px}
</style>
<div id="linkGate" role="status" style="max-width:420px;margin:36px auto;padding:16px">専用リンクを確認中です。</div><main hidden><nav class="modeNav" aria-label="画面"><button id="navMaterial">素材分析</button><button id="navKaraoke">リアルタイム</button></nav><div id="meterHome"><div class="brand">PITCH METER</div><h1>声の高さを、<br>なめらかに映す。</h1><label class="primary select">動画・音声を選ぶ<input id="playfile" type="file" accept="audio/*,video/*,image/*,.mp3,.m4a,.aac,.wav,.flac,.ogg,.opus,.aif,.aiff,.caf,.mp4,.mov,.m4v,.webm,.mkv,.avi,.3gp,.jpg,.jpeg,.png,.heic,.heif,.webp,.gif" aria-label="動画・音声を選ぶ"></label><section class="editor"><div id="filename"></div><small id="importStatus" role="status"></small><div class="stage"><video id="media" playsinline preload="metadata"></video><div id="meter" class="meter"><div class="fixed"><span>地声</span><span>ミックス</span><span>裏声</span></div><div class="rail" aria-hidden="true"></div><div class="tick" style="left:0%"></div><div class="tick" style="left:25%"></div><div class="tick" style="left:50%"></div><div class="tick" style="left:75%"></div><div class="tick" style="left:100%"></div><div id="dot" class="dot" aria-hidden="true"></div><div id="pointer" class="pointer"><output id="pitch">— Hz</output><output id="label"></output></div><div class="endpoints"><span>最低音 mid1E</span><span>最高音 hiD</span></div></div><small class="disclaimer">表示は音の高さに基づく目安です。発声や音域には個人差があります</small></div><div class="playrow"><button id="play" disabled>再生</button><button id="reset" disabled>停止</button><small id="pos">00:00 / 00:00</small></div><input id="seek" type="range" min="0" max="1" value="0" step="0.05" disabled aria-label="再生位置"><div><button id="exportVideo" disabled>動画を書き出す</button><button id="saveVideo" hidden>保存・共有</button><small id="exportStatus" role="status"></small></div></section><button id="mic">マイクを開始</button><button id="stop" disabled>停止</button><meter id="level" min="-80" max="0" value="-80" aria-label="入力レベル"></meter><output id="msg" aria-live="polite">マイク停止中</output><small>非公開のWeb試作。声種は判定が安定したときだけ表示します。素材とマイク音声は端末内で処理し、外部に送信しません。書き出し動画は「保存・共有」から保存できます。</small><button id="toLabels" type="button">歌声の区間ラベル</button></div>
<section id="labelsPage" hidden aria-labelledby="labelsTitle">
<div class="brand">PITCH METER / LABELS</div><h2 id="labelsTitle">歌声の区間ラベル</h2>
<button id="toMeter" type="button">メーターに戻る</button>
<div id="artistCards" aria-label="アーティスト別サンプル"></div><div id="manualArtist"><button id="openManualEditor" type="button">その他の音源・以前の下書き</button><small id="manualArtistCount"></small><div id="manualEditorMount"></div></div><div id="artistDetail" hidden><div class="artistDetailHead"><h3 id="artistDetailTitle"></h3><button id="artistBack" type="button" aria-label="編集画面を閉じて一覧に戻る">×</button></div><ul id="artistDetailTracks" class="artistDetailTracks"></ul><div id="artistDetailMount"></div></div><div id="artistEditor" hidden><label class="select">音声ファイルを選ぶ<input id="labelFile" type="file" aria-label="音声ファイルを選ぶ"></label>
<small id="labelsInfo" role="status">音声は端末内だけで処理します。区間は下書き保存されますが、音声は保存されません。</small>
<div id="labelWorkspace" hidden>
<div id="labelsFileName"></div><div class="tagFields">
<label>歌い手ID<input id="lblSinger" autocomplete="off" maxlength="90" placeholder="例：S01"></label>
<label>歌い手の用途<select id="lblRole"><option>未指定</option><option>判定基準用</option><option>テスト専用</option></select></label>
<label>伴奏<select id="lblBacking"><option>不明</option><option>なし</option><option>あり</option></select></label>
<label>今回の用途で利用可<select id="lblAllowed"><option>未確認</option><option>可</option><option>不可</option></select></label>
</div>
<div class="waveHead"><strong class="cursorLine">再生位置 <output id="lblCursorTime">00:00.000</output></strong><span>空いている位置をタップ。再生ヘッドは長押しして移動。</span></div><div id="lblScrub" role="slider" tabindex="0" aria-label="再生位置" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0"><span id="lblScrubHead" aria-hidden="true"></span></div><div id="lblScrubMarks" aria-hidden="true"><span>00:00.000</span><span></span><span></span><span>00:00.000</span></div>
<div class="waveHead"><span id="lblDuration">00:00.000</span><label>表示倍率 <select id="lblZoom"><option value="1">全体</option><option value="2">2×</option><option value="4">4×</option><option value="8">8×</option><option value="16">16×</option><option id="lblZoomCustom" value="custom" hidden disabled></option></select></label></div>

<div id="lblTimeline">
<canvas id="lblWave" aria-label="音声の波形"></canvas>
<button id="lblStartHandle" class="lblHandle" type="button" aria-label="開始位置。左右キーで調整">開始</button>
<button id="lblEndHandle" class="lblHandle" type="button" aria-label="終了位置。左右キーで調整">終了</button>
</div>
<div class="wavePlayback"><button id="lblListen" type="button">再生</button></div><div class="waveHead"><span id="waveLo">00:00.000</span><span id="waveHi">00:00.000</span></div>
<label class="lblScrollBar">横スクロール <input id="lblScroll" type="range" min="0" max="0" value="0" step=".001" aria-label="波形の表示位置" disabled></label>
<small>波形は2本指で拡大・縮小。空いている位置をタップするか、再生位置の黄色い線を長押しして1本指で動かせます。開始・終了は左右にドラッグ。細かい指定は下の秒数で。キー操作は左右で0.01秒、Shift＋左右で0.1秒。</small><fieldset id="lblKinds"><legend>選択区間種別</legend><div><button type="button" data-kind="地声" aria-pressed="true">地声</button><button type="button" data-kind="裏声" aria-pressed="false">裏声</button><button type="button" data-kind="ミックス" aria-pressed="false">ミックスボイス</button><button type="button" data-kind="保留" aria-pressed="false">保留</button></div></fieldset><button id="lblCommit" type="button">選択区間反映</button><output id="lblCommitStatus" role="status"></output>
<div class="tagFields">
<label>開始（秒）<input id="lblStart" type="number" inputmode="decimal" min="0" step=".001" value="0"></label>
<label>終了（秒）<input id="lblEnd" type="number" inputmode="decimal" min="0" step=".001" value="1"></label>
<label hidden>判定<select id="lblKind"><option>地声</option><option>裏声</option><option>ミックス</option><option>保留</option></select></label>
</div>
<label class="labelNote">メモ<input id="lblNote" autocomplete="off" maxlength="400"></label>
<button id="lblRangeListen" type="button">選択区間を最初から再生</button><button id="lblCancel" type="button" hidden>編集を取り消す</button>
<audio id="lblPlayer" preload="metadata" playsinline></audio>
</div>
<h3><span id="artistLabelCountTitle">追加した区間</span> <span id="lblCount">0</span></h3>
<ul id="lblRows"></ul></div><details id="artistProject"><summary>プロジェクトの保存・判定設定</summary><small id="lblDraftStatus" role="status">Safariのサイトデータは消えることがあります。下書きはプロジェクトJSONでも保存できます。</small><button id="lblBackup" type="button" disabled>プロジェクトJSONを保存</button><label class="select">プロジェクトJSONを読み込む<input id="lblRestore" type="file" accept="application/json,.json" aria-label="プロジェクトJSONを読み込む"></label><button id="lblCSV" type="button" disabled>全サンプルのCSVを保存・共有</button><h3>メーターの判定基準</h3><small id="lblModelStatus" role="status"></small><small>「判定基準用」かつ「利用可」の裏声・ミックスを初期サンプルに足します。テスト専用と用途未指定は反映しません。地声は2区間以上あると誤表示を抑えるために使用し、メーターに声種ラベルは追加しません。保留はCSVだけに記録します。適用済みの追加分は今回の区間で置き換わります。保存するのは集計値だけです。</small><button id="lblApplyModel" type="button">区間を判定に反映</button><output id="lblApplyStatus" role="status"></output><p>区間の保存とメーター判定への反映は別です。このボタンで全アーティストをまとめて反映します。</p><h4>いまの下書き・反映対象</h4><ul id="lblLearnCoverage"></ul><h4>実際に適用中の追加区間</h4><ul id="lblLearnSnapshot"></ul><button id="lblResetModel" type="button" disabled>初期基準に戻す</button><h3>本番への引き継ぎ</h3><small id="lblHandoffStatus" role="status">前回反映した判定基準だけを書き出します。区間を編集したあとに更新する場合は、先に「区間を判定に反映」を押してください。</small><button id="lblHandoff" type="button" disabled>本番引き継ぎ用データを書き出す</button></details><details id="lblAcousticPanel"><summary>波形・声質・フォルマント分析</summary><p>このタブで選択した利用可の元音声から、保存区間をまとめて分析します。「声質を分析」は表示のみ。「まとめて分析・反映」は、基準用の元録音がそろった場合に使える区間を一度で判定に反映します。履歴だけでは解析できません。</p><p>フォルマント（F1〜F3）は声の共鳴の推定値です。伴奏あり・不明、高い音程、弱い周期性、推定が一致しない区間では表示しません。</p><button id="lblAcoustic" type="button">開いた音声の声質を分析</button><button id="lblAcousticApply" type="button">まとめて分析・反映</button><button id="lblCompare" type="button">倍音とフォルマントを比較</button><button id="lblCancelAcoustic" type="button" hidden>分析を停止</button><small id="lblAcousticStatus" role="status"></small><div id="lblAcousticBody"></div><div id="lblCompareBody" aria-live="polite"></div></details>
</section><div id="karaokePage" hidden>
<div class="brand">REALTIME / KARAOKE</div><h1>見本に重ねて、<br>声を描こう。</h1>
<p class="kIntro">フレーズごとに見本を表示。動く縦メーターに合わせて歌おう。</p>
<label for="kSource">素材の種類</label><select id="kSource"><option value="mixed">伴奏入り（端末内で歌声を分離）</option><option value="vocals">歌声のみ（分離しない）</option></select><label class="select">写真かファイルから選ぶ<input id="kFile" type="file" accept="audio/*,video/*,image/*,.mp3,.m4a,.aac,.wav,.flac,.ogg,.opus,.aif,.aiff,.caf,.mp4,.mov,.m4v,.webm,.mkv,.avi,.3gp,.jpg,.jpeg,.png,.heic,.heif,.webp,.gif" aria-label="写真かファイルから選ぶ"></label>
<small>写真ライブラリからは画面収録などの音声付き動画を、ファイルからは動画やMP3・M4A・WAVなどの音声を選べます。HEVC動画・画面録画・MP3/M4A/WAV/FLAC/OGG/AIFFなどに対応。長さ・サイズの上限はありません（長い曲ほど分離に時間がかかります。目安：曲の長さの半分ほど）。写真は音が無いので使えません。</small>
<p id="kStatus" role="status" aria-live="polite">素材を選ぶと、音程の見本を作ります。</p>
<p id="kKey" role="status">キー：未解析</p>
<div class="kStage"><canvas id="kCanvas" aria-label="見本バーと歌唱一致部分"></canvas><output id="kCount" aria-live="assertive"></output></div>
<div class="kLegend"><span>━ 見本バー（推定）</span><strong>━ 歌唱一致</strong><span style="color:#ff667d">━ 一致50%未満</span><output id="kTime">0:00 / 0:00</output></div>
<p id="kPhrase" role="status">フレーズ未解析</p><label for="kReview">停止中の確認位置</label><input id="kReview" type="range" min="0" max="0" step="0.04" value="0" disabled style="width:100%;min-height:44px;accent-color:#f285be" aria-label="フレーズの確認位置"><div class="kControls"><button id="kPlay" disabled>再生</button><button id="kStop" disabled>停止</button><button id="kScore" disabled>採点する</button></div>
<section id="kResult" hidden aria-live="polite"></section>
<details><summary>使い方と暫定採点について</summary><p>見本バーはページ内で固定され、縦メーターが左から右へ進みます。右端で次のフレーズへ瞬時に切り替わります。見本バーの末端を通過した時に、そのバー全長の一致割合を一度判定します。差が2半音未満の時間が70%以上なら全長を紫からピンクのグラデーションと淡い光沢に、50%以上70%未満なら従来の一致色に、50%未満で高低の方向が明確なら一続きの赤バーを表示します。赤バーは実唱の代表的なずれの方向へ最低1半音、最大2音（4半音）の範囲で動かします。無発声や方向の根拠が乏しい場合は、見本の色のままです。波形や点々は描きません。ページをまたぐ長音も元のバー全体で判定します。表示と採点は別で、採点は2半音ちょうども減点なしです。フレーズの70%地点で、それまでの見本に対する一致率が70%以上、かつ0.4秒以上の発声を確認できると一度だけ淡いキラキラを表示します（視差効果を減らす設定では省略）。休符を優先し、長い連続部分は最大8秒で区切ります。停止中の確認位置は表示の見直し用で、再生は常に先頭からです。イヤホンを使い、マイクを許可して「再生」。3、2、1の後に素材が流れます。終了後に採点できます。途中停止や画面を離れた回は採点しません。</p><p>Spleeterで端末内分離してから、歌声だけを見本バー・採点基準に使います。再生は元の伴奏入り音声です。初回はモデル等の約90MBを読み込みますが、素材は送信しません。分離は完全ではなく、楽器の漏れや歌声の欠落が残る場合があります。失敗時は混合音を見本に代用しません。iPhone実機は未検証のため、まず短い素材でお試しください。音程検出範囲は約90〜800Hzです。バーは表示用に音程をまとめ、休符・不確実区間を空けます。見本は前後の音と基音・倍音の候補を比較し、誤検出が強く疑われる短い飛びだけ補正します。キーは歌声から自動推定し、確信があるときだけ候補選択の補助に使います。キー外音を一律に移動しません。長音中の80ms以内の隙間は音響候補が残る場合だけ表示をつなぎ、採点には加えません。バーの音名への丸めは表示だけです。実唱のオクターブ抑制とポインターの短い保持は維持します。ライブの持続するオクターブ変化は最大約80msで追従します。利用モデルとライセンスはメーター画面のいちばん下にあります。</p><p>全体を最大±1.5秒の範囲で一度だけ時間移動し、最も一致する位置で暫定採点します。各時点の音程差は上下200セント（2半音）以内なら音程減点なし。超えた分を300セントで最大100点の減点に換算します。時間位置の同点は許容幅を適用する前の音程差で比較し、無音・欠落も従来どおり減点します。基礎点の上限は歌い欠け率で制限します。有効な発声が合計1秒以上・見本の20%以上あり、連続0.4秒以上を確認できた回は22〜27点を一度だけランダム加算し、合計100点を上限にします。同じ回の再採点で加点は変わりません。無音や短いノイズだけには加点しません。歌唱力を評価する正式な点数ではありません。</p><p>素材・マイクは端末内だけで処理します。マイクの生音声は保存せず、練習中の音程値のみメモリに保持します。ページを閉じると消えます。</p></details>
</div></main><script>/* Browser-local QuickTime/ISO BMFF audio extraction. No file writes, video decode, network or upload. */
'use strict';
(function(root){
const invalid=()=>Error('動画の音声情報を読み取れませんでした。');
const read=(v,p)=>v.getUint32(p);
function name(v,p){return String.fromCharCode(v.getUint8(p),v.getUint8(p+1),v.getUint8(p+2),v.getUint8(p+3))}
function u64(v,p){const n=read(v,p)*4294967296+read(v,p+4);if(!Number.isSafeInteger(n))throw invalid();return n}
function list(v,start,end){
 const out=[];
 for(let p=start;p+8<=end;){
  let size=read(v,p),head=8;
  if(size===1){if(p+16>end)throw invalid();size=u64(v,p+8);head=16}
  else if(size===0)size=end-p;
  if(size<head||p+size>end)throw invalid();
  out.push({type:name(v,p+4),p,b:p+head,e:p+size});
  if(out.length>100000)throw invalid();
  p+=size;
 }
 return out;
}
const child=(v,b,key)=>b&&list(v,b.b,b.e).find(x=>x.type===key);
const get=(v,b,...keys)=>keys.reduce((x,key)=>child(v,x,key),b);
function inspect(buf){
 if(buf.byteLength<8)return null;
 const v=new DataView(buf),u=new Uint8Array(buf);
 if(!['ftyp','free','wide','skip','uuid','moov','mdat'].includes(name(v,4)))return null;
 const atoms=list(v,0,v.byteLength),moov=atoms.find(x=>x.type==='moov');
 if(!moov)return null;
 const tracks=list(v,moov.b,moov.e).filter(x=>x.type==='trak').map(t=>{
  const h=get(v,t,'mdia','hdlr');
  return {...t,handler:h&&h.e-h.b>=12?name(v,h.b+8):''};
 });
 return {v,u,moov,tracks,media:atoms.filter(a=>a.type==='mdat'),fragmented:atoms.some(a=>a.type==='moof')};
}
function bound(p,length,box){if(!Number.isSafeInteger(p)||length<0||p<box.b||p+length>box.e)throw invalid()}
function entries(info,track){
 const {v,media}=info,stbl=get(v,track,'mdia','minf','stbl'),sz=child(v,stbl,'stsz'),sc=child(v,stbl,'stsc');
 const co=child(v,stbl,'stco')||child(v,stbl,'co64'),sd=child(v,stbl,'stsd');
 if(info.fragmented||!sz||!sc||!co||!sd||!media.length)throw invalid();
 bound(sz.b,12,sz);bound(sc.b,8,sc);bound(co.b,8,co);bound(sd.b,8,sd);
 const fixed=read(v,sz.b+4),samples=read(v,sz.b+8),groups=read(v,sc.b+4),count=read(v,co.b+4),stride=co.type==='co64'?8:4;
 if(!(samples>0&&groups>0&&groups<=count&&count<=samples))throw invalid();
 if(!fixed)bound(sz.b+12,samples*4,sz);
 bound(sc.b+8,groups*12,sc);bound(co.b+8,count*stride,co);
 const sets=[];
 for(let i=0;i<groups;i++){
  const p=sc.b+8+i*12,first=read(v,p),per=read(v,p+4),desc=read(v,p+8);
  if((i===0?first!==1:first<=sets[i-1].first)||first>count||!per||!desc)throw invalid();
  sets.push({first,per,desc});
 }
 const chunks=[];let si=0,group=0;
 for(let i=0;i<count;i++){
  if(sets[group+1]?.first===i+1)group++;
  const {per,desc}=sets[group],p=co.b+8+i*stride,offset=stride===8?u64(v,p):read(v,p);
  if(si+per>samples)throw invalid();
  let len=fixed*per;
  if(!fixed)for(let j=0;j<per;j++)len+=read(v,sz.b+12+(si+j)*4);
   // mdat regions are ordered; keep malformed-file lookup bounded at large chunk counts.
  let lo=0,hi=media.length;
  while(lo<hi){const mid=(lo+hi)>>1;if(media[mid].b<=offset)lo=mid+1;else hi=mid;}
  const region=media[lo-1];
  if(!len||!region||offset+len>region.e)throw invalid();
  chunks.push({offset,len,p,si,per,desc});si+=per;
 }
 if(si!==samples)throw invalid();
 return {chunks,stride,sd,size:i=>fixed||read(v,sz.b+12+i*4)};
}
function putName(v,p,t){for(let i=0;i<4;i++)v.setUint8(p+i,t.charCodeAt(i))}
function header(v,p,bytes,t){v.setUint32(p,bytes);putName(v,p+4,t)}
function remux(info){
 const {v,u,moov,tracks}=info,audio=tracks.filter(t=>t.handler==='soun'),mvhd=child(v,moov,'mvhd');
 if(!audio.length||!mvhd||audio.length>8)throw invalid();
 const plans=audio.map(track=>({track,...entries(info,track)}));
 const bytes=plans.reduce((n,q)=>q.chunks.reduce((a,c)=>a+c.len,n),0),ftyp=24;
 if(!bytes||bytes>u.length)throw invalid();
 const movie=8+(mvhd.e-mvhd.p)+plans.reduce((n,{track})=>n+track.e-track.p,0);
 const out=new Uint8Array(ftyp+movie+8+bytes),d=new DataView(out.buffer);
 header(d,0,ftyp,'ftyp');putName(d,8,'M4A ');putName(d,16,'isom');putName(d,20,'mp42');
 header(d,ftyp,movie,'moov');header(d,ftyp+movie,8+bytes,'mdat');
 let p=ftyp+8,offset=ftyp+movie+8;
 out.set(u.subarray(mvhd.p,mvhd.e),p);p+=mvhd.e-mvhd.p;
 for(const {track,chunks,stride} of plans){
  out.set(u.subarray(track.p,track.e),p);
  for(const c of chunks){
   const at=p+c.p-track.p;if(stride===8){d.setUint32(at,0);d.setUint32(at+4,offset)}else d.setUint32(at,offset);
   out.set(u.subarray(c.offset,c.offset+c.len),offset);offset+=c.len;
  }
  p+=track.e-track.p;
 }
 return out.buffer;
}
function decoderAsc(info,sample){
 const {v,u}=info;if(sample.type!=='mp4a')throw invalid();
 bound(sample.b,28,sample);
 const type=v.getUint16(sample.b+8),base=sample.b+(type===0?28:type===1?44:type===2?64:0);
 if(base===sample.b||base>sample.e)throw invalid();
 const esds=list(v,base,sample.e).find(x=>x.type==='esds'||x.type==='wave');
 const box=esds?.type==='wave'?child(v,esds,'esds'):esds;
 if(!box)throw invalid();
 function descriptor(a,b,depth=0){
  if(depth>4)return null;
  for(let p=a;p+2<=b;){
   const t=u[p++];let n=0,done=false;
   for(let i=0;i<4&&p<b;i++){const x=u[p++];n=n*128+(x&127);if(!(x&128)){done=true;break}}
   if(!done||p+n>b)return null;
   if(t===5&&n>=2)return u.subarray(p,p+n);
   if(t===3&&n>=3){const f=u[p+2];let j=p+3;if(f&128)j+=2;if(f&64)j+=1+(u[j]||0);if(f&32)j+=2;const x=descriptor(j,p+n,depth+1);if(x)return x;}
   if(t===4&&n>=13){const x=descriptor(p+13,p+n,depth+1);if(x)return x;}
   p+=n;
  }
  return null;
 }
 const a=descriptor(box.b+4,box.e);if(!a)throw invalid();
 const profile=a[0]>>3,fi=((a[0]&7)<<1)|(a[1]>>7),channels=(a[1]>>3)&15;
 // ADTS stores regular AAC Main/LC/SSR/LTP, not explicit HE-AAC/ALAC or custom layouts.
 if(profile<1||profile>4||fi>12||channels<1||channels>7)throw invalid();
 return {profile,fi,channels};
}
function timeline(info,t){
 const {v,moov}=info,mvhd=child(v,moov,'mvhd'),mdhd=get(v,t,'mdia','mdhd'),el=get(v,t,'edts','elst');
 if(!el)return null;
 const getScale=h=>{if(!h)throw invalid();const p=h.b+(v.getUint8(h.b)===1?20:12);bound(p,4,h);return read(v,p)};
 const m=getScale(mvhd),a=getScale(mdhd);bound(el.b,8,el);
 const count=read(v,el.b+4),ver=v.getUint8(el.b),stride=ver===1?20:12;
 if(!m||!a||count<1||count>2||ver>1)throw invalid();
 bound(el.b+8,count*stride,el);
 let lead=0,clip=null;
 for(let i=0;i<count;i++){
  const p=el.b+8+stride*i,q=p+(ver===1?8:4);
  const dur=ver===1?u64(v,p):read(v,p);
  const media=ver===1&&v.getInt32(q)!==-1?u64(v,q):ver===1?(read(v,q+4)===4294967295?-1:-2):v.getInt32(q);
  if(v.getInt16(q+(ver===1?8:4))!==1||v.getInt16(q+(ver===1?10:6))!==0)throw invalid();
  if(media===-1&&i===0)lead=dur/m;
  else if(media>=0&&i===count-1)clip={lead,start:media/a,len:dur/m};
  else throw invalid();
 }
 if(!clip||!Number.isFinite(clip.lead+clip.len+clip.start))throw invalid();
 return clip;
}
function adts(info){
 const {u,v}=info, audio=info.tracks.filter(x=>x.handler==='soun');
 // Never drop/mix secondary tracks in the emergency AAC path.
 if(audio.length!==1)throw invalid();
 const track=audio[0],q=entries(info,track),d=list(v,q.sd.b+8,q.sd.e);
 if(q.chunks.some(c=>c.desc!==1)||!d[0])throw invalid();
 const a=decoderAsc(info,d[0]),edit=timeline(info,track);
 let n=0;
 for(const {si,per} of q.chunks)for(let j=0;j<per;j++){const s=q.size(si+j);if(s<1||s>8184)throw invalid();n+=s+7}
 if(!n||n>u.length*2)throw invalid();
 const out=new Uint8Array(n);let p=0;
